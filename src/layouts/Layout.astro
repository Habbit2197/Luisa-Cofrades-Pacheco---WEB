---
import '@fontsource-variable/plus-jakarta-sans';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "Luisa Cofrades Pacheco | Gabinete de Psicología en Salamanca y Zamora",
  description = "Psicóloga Sanitaria Colegiada. Especialista en EMDR, terapia sensoriomotriz, ansiedad, duelo y trauma. Consultas presenciales en Salamanca y Zamora, y terapia online.",
  ogImage = "/assets/branding/logo-luisa-positivo404x.png"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://luisacofrades.com');
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/assets/branding/cropped-logo-simbolo404x.png" />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Metadatos SEO Primarios -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Luisa Cofrades Pacheco" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Meta de Redes Sociales -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, canonicalURL)} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Luisa Cofrades Pacheco - Psicología para vivir" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@LCofrades" />
    <meta name="twitter:creator" content="@LCofrades" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, canonicalURL)} />

    <!-- Schema.org JSON-LD para Gabinete Sanitario de Psicología -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "PsychologicalClinic",
        "name": "Luisa Cofrades Pacheco - Psicología para vivir",
        "image": "https://luisacofrades.com/assets/branding/logo-luisa-positivo404x.png",
        "url": "https://luisacofrades.com",
        "telephone": "+34675809974",
        "priceRange": "$$",
        "address": [
          {
            "@type": "PostalAddress",
            "streetAddress": "Calle del Prior 5-7, 1º B",
            "addressLocality": "Salamanca",
            "postalCode": "37002",
            "addressRegion": "Salamanca",
            "addressCountry": "ES"
          },
          {
            "@type": "PostalAddress",
            "streetAddress": "Roelos de Sayago",
            "addressLocality": "Roelos de Sayago",
            "addressRegion": "Zamora",
            "addressCountry": "ES"
          }
        ],
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": "40.9650",
          "longitude": "-5.6640"
        },
        "openingHours": "Mo-Fr 09:00-20:00",
        "medicalSpecialty": [
          "ClinicalPsychology",
          "Psychotherapy",
          "EMDR"
        ]
      }
    </script>
  </head>
  <body class="bg-sand-50 text-slateText-base font-sans antialiased selection:bg-brand-200 selection:text-brand-900 flex flex-col min-h-screen">
    <!-- Barra superior de contacto rápido y acreditación -->
    <header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-sand-200/80 transition-all duration-300">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-20">
          
          <!-- Logo de la web con diseño original modernizado -->
          <a href="/" class="flex items-center gap-3 group" aria-label="Inicio - Luisa Cofrades">
            <img 
              src="/assets/branding/cropped-logo-simbolo404x.png" 
              alt="Símbolo Luisa Cofrades" 
              class="w-10 h-10 object-contain rounded-full shadow-sm group-hover:scale-105 transition-transform" 
            />
            <div class="flex flex-col">
              <span class="text-base sm:text-lg font-semibold tracking-tight text-slateText-dark group-hover:text-brand-700 transition-colors">
                Luisa Cofrades Pacheco
              </span>
              <span class="text-xs uppercase tracking-widest text-brand-600 font-medium">
                Psicología para vivir
              </span>
            </div>
          </a>

          <!-- Navegación desktop -->
          <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slateText-muted">
            <a href="#sobre-mi" class="hover:text-brand-700 transition-colors">Sobre mí</a>
            <a href="#servicios" class="hover:text-brand-700 transition-colors">Terapias</a>
            <a href="#emdr" class="hover:text-brand-700 transition-colors">EMDR</a>
            <a href="#sedes" class="hover:text-brand-700 transition-colors">Sedes (Salamanca y Zamora)</a>
            <a href="#testimonios" class="hover:text-brand-700 transition-colors">Testimonios</a>
          </nav>

          <!-- Botón de Acción Directo -->
          <div class="flex items-center gap-3">
            <a 
              href="tel:+34675809974" 
              class="hidden sm:inline-flex items-center gap-2 text-sm font-semibold text-brand-700 hover:text-brand-800 px-3 py-2 rounded-lg hover:bg-brand-50 transition-colors"
            >
              <svg class="w-4 h-4 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              <span>675 80 99 74</span>
            </a>

            <a 
              href="#contacto" 
              class="inline-flex items-center justify-center px-4 sm:px-5 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-sm font-medium shadow-sm hover:shadow-card-hover transition-all duration-200"
            >
              Pedir cita
            </a>
          </div>

        </div>
      </div>
    </header>

    <main class="flex-grow">
      <slot />
    </main>

  </body>
</html>

