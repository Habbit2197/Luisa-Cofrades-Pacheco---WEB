---
import '@fontsource-variable/plus-jakarta-sans';
import '../styles/global.css';
import { ClientRouter as ViewTransitions } from 'astro:transitions';
import FloatingMobileBar from '../components/FloatingMobileBar.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogImage?: string;
  type?: 'website' | 'article';
}

const {
  title = "Psicología para vivir centro de Luisa Cofrades.",
  description = "¿Cómo podemos ayudarte? Equipo especializado en trauma y experiencias adversas.",
  image = Astro.props.ogImage || "/assets/branding/og-image.jpg",
  type
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);

const isBlogPost = Astro.url.pathname.startsWith('/blog/') && Astro.url.pathname !== '/blog/' && Astro.url.pathname !== '/blog';
const ogType = type || (isBlogPost ? 'article' : 'website');
---

<!doctype html>
<html lang="es" class="scroll-smooth bg-white text-brand-graphite">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/assets/branding/cropped-logo-simbolo404x.png" />
    <link rel="canonical" href={canonicalURL.href} />
    
    <!-- Metadatos SEO Primarios -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Luisa Cofrades Pacheco" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Meta de Redes Sociales -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Luisa Cofrades Pacheco" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={ogImageURL.href} />
    <meta property="og:image:secure_url" content={ogImageURL.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@LCofrades" />
    <meta name="twitter:creator" content="@LCofrades" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL.href} />

    <!-- Schema.org JSON-LD para Gabinete Sanitario de Psicología -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "PsychologicalClinic",
        "name": "Psicología para vivir centro de Luisa Cofrades.",
        "image": "https://luisa-cofrades-pacheco---web.javier-barmont97.workers.dev/assets/branding/og-image.jpg",
        "url": "https://luisa-cofrades-pacheco---web.javier-barmont97.workers.dev",
        "telephone": "+34675809974",
        "priceRange": "$$",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Calle del Prior 5-7, 1º B",
          "addressLocality": "Salamanca",
          "postalCode": "37002",
          "addressRegion": "Salamanca",
          "addressCountry": "ES"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": "40.9650",
          "longitude": "-5.6640"
        },
        "openingHours": "Mo-Fr 09:00-20:00",
        "medicalSpecialty": [
          "ClinicalPsychology",
          "Psychotherapy",
          "EMDR"
        ]
      }
    </script>

    <!-- Astro View Transitions para navegación fluida SPA -->
    <ViewTransitions />
  </head>
  <body class="bg-white text-brand-graphite font-sans antialiased selection:bg-brand-aqua/20 selection:text-brand-aqua-dark flex flex-col min-h-screen">
    <!-- Barra superior de navegación corporativa -->
    <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-gray-100 transition-all duration-300">
      <div class="max-w-screen-2xl mx-auto px-4 sm:px-6 md:px-8 xl:px-12">
        <div class="flex items-center justify-between min-h-[5.5rem] sm:min-h-[6.5rem] lg:min-h-[7rem] py-3 sm:py-4 lg:py-5">
          
          <!-- Logo con fade-in y slide-in estático al hacer scroll -->
          <a href="/" class="group flex items-center flex-shrink-0" aria-label="Inicio - Luisa Cofrades Pacheco">
            <div class="flex-shrink-0 relative w-32 sm:w-40 md:w-48 lg:w-56 h-12 sm:h-16 md:h-20 flex items-center justify-start">
              <img 
                id="logo-static"
                src="/assets/branding/logo-luisa-positivo404x.png" 
                alt="Logo Luisa Cofrades Pacheco" 
                width="256"
                height="108"
                loading="eager"
                decoding="async"
                class="w-full h-full object-contain scale-[1.12] sm:scale-[1.18] md:scale-[1.22] origin-[left_center] opacity-100 translate-y-0 md:opacity-0 md:translate-y-[-10px] transition-all duration-500 ease-out" 
              />
            </div>
            <span class="sr-only">Luisa Cofrades Pacheco - Psicología para vivir</span>
          </a>

          <!-- Navegación desktop: enlaces de navegación -->
          <nav class="hidden md:flex items-center gap-6 lg:gap-8 xl:gap-10 text-sm font-medium text-brand-graphite/80">
            <a href="/" class="hover:text-brand-aqua transition-colors">Inicio</a>
            <a href="/#sobre-mi" class="hover:text-brand-aqua transition-colors">Sobre mí</a>
            <a href="/#equipo" class="hover:text-brand-aqua transition-colors">Equipo</a>
            <a href="/#nuestro-espacio" class="hover:text-brand-aqua transition-colors">Nuestro espacio</a>
            
            <!-- Menú Desplegable Especialidades -->
            <div class="relative group py-2">
              <button 
                type="button" 
                class="flex items-center gap-1.5 hover:text-brand-aqua transition-colors focus:outline-none"
                aria-expanded="false"
                aria-haspopup="true"
              >
                <span>Especialidades</span>
                <svg class="w-3.5 h-3.5 text-brand-graphite/60 group-hover:text-brand-aqua group-hover:rotate-180 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </button>

              <!-- Submenú Flotante Desktop -->
              <div class="absolute left-1/2 -translate-x-1/2 top-full pt-2 opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50 pointer-events-none group-hover:pointer-events-auto">
                <div class="w-72 bg-white rounded-2xl shadow-xl border border-gray-100 p-2.5 space-y-1">
                  <a 
                    href="/psicoterapia-individual" 
                    class="block px-3.5 py-2.5 rounded-xl hover:bg-brand-aqua/5 text-brand-graphite hover:text-brand-aqua transition-colors"
                  >
                    <p class="font-semibold text-sm">Psicoterapia de Adultos</p>
                    <p class="text-xs text-brand-graphite/60 mt-0.5">Acompañamiento individual y trauma</p>
                  </a>
                  <a 
                    href="/psicoterapia-infanto-juvenil" 
                    class="block px-3.5 py-2.5 rounded-xl hover:bg-brand-aqua/5 text-brand-graphite hover:text-brand-aqua transition-colors"
                  >
                    <p class="font-semibold text-sm">Psicoterapia Infanto-Juvenil</p>
                    <p class="text-xs text-brand-graphite/60 mt-0.5">Atención especializada a menores</p>
                  </a>
                  <a 
                    href="/#sand-play-therapy" 
                    class="block px-3.5 py-2.5 rounded-xl hover:bg-brand-aqua/5 text-brand-graphite hover:text-brand-aqua transition-colors"
                  >
                    <p class="font-semibold text-sm">Sand Play Therapy (Caja de Arena)</p>
                    <p class="text-xs text-brand-graphite/60 mt-0.5">Técnica simbólica e integradora</p>
                  </a>
                  <a 
                    href="/#emdr" 
                    class="block px-3.5 py-2.5 rounded-xl hover:bg-brand-aqua/5 text-brand-graphite hover:text-brand-aqua transition-colors"
                  >
                    <p class="font-semibold text-sm">Terapia EMDR</p>
                    <p class="text-xs text-brand-graphite/60 mt-0.5">Reprocesamiento y evidencia científica</p>
                  </a>
                </div>
              </div>
            </div>

            <a href="/#tarifas" class="hover:text-brand-aqua transition-colors">Tarifas</a>
            <a href="/#contacto" class="hover:text-brand-aqua transition-colors">Contacto</a>
          </nav>

          <!-- Acciones de contacto y menú móvil -->
          <div class="flex items-center gap-3">
            <a 
              href="tel:+34675809974" 
              class="hidden sm:inline-flex items-center gap-2 text-sm font-semibold text-brand-aqua hover:text-brand-aqua-dark px-3 py-2 rounded-lg hover:bg-gray-50 transition-colors"
            >
              <svg class="w-4 h-4 text-brand-aqua" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              <span>675 80 99 74</span>
            </a>

            <a 
              href="/#contacto" 
              class="inline-flex items-center justify-center px-4 sm:px-5 py-2.5 rounded-xl bg-brand-aqua hover:bg-brand-aqua-hover text-white text-sm font-medium shadow-sm hover:shadow-card-hover transition-all duration-200"
            >
              Pedir cita
            </a>

            <!-- Botón Hamburguesa Móvil -->
            <button 
              id="mobile-menu-toggle"
              type="button"
              class="md:hidden inline-flex items-center justify-center p-2 rounded-xl text-brand-graphite hover:bg-gray-100 transition-colors"
              aria-controls="mobile-nav-menu"
              aria-expanded="false"
              aria-label="Abrir menú de navegación"
            >
              <svg id="icon-hamburger" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
              <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>

        </div>
      </div>

      <!-- Menú Desplegable Móvil -->
      <nav 
        id="mobile-nav-menu" 
        class="hidden md:hidden border-t border-gray-100 bg-white/98 backdrop-blur-md px-6 py-5 shadow-lg"
      >
        <div class="flex flex-col gap-3 text-base font-medium text-brand-graphite">
          <a href="/" class="mobile-nav-link py-2 border-b border-gray-100 hover:text-brand-aqua transition-colors">Inicio</a>
          <a href="/#sobre-mi" class="mobile-nav-link py-2 border-b border-gray-100 hover:text-brand-aqua transition-colors">Sobre mí</a>
          <a href="/#equipo" class="mobile-nav-link py-2 border-b border-gray-100 hover:text-brand-aqua transition-colors">Equipo</a>
          <a href="/#nuestro-espacio" class="mobile-nav-link py-2 border-b border-gray-100 hover:text-brand-aqua transition-colors">Nuestro espacio</a>
          
          <!-- Especialidades Móvil: Sub-enlaces directos con sangría pl-4 -->
          <div class="py-2 border-b border-gray-100">
            <span class="text-xs uppercase tracking-widest text-brand-aqua font-bold block mb-2">
              Especialidades
            </span>
            <div class="flex flex-col gap-2.5 pl-4">
              <a href="/psicoterapia-individual" class="mobile-nav-link py-1 text-sm text-brand-graphite/80 hover:text-brand-aqua transition-colors block">
                Psicoterapia de Adultos
              </a>
              <a href="/psicoterapia-infanto-juvenil" class="mobile-nav-link py-1 text-sm text-brand-graphite/80 hover:text-brand-aqua transition-colors block">
                Psicoterapia Infanto-Juvenil
              </a>
              <a href="/#sand-play-therapy" class="mobile-nav-link py-1 text-sm text-brand-graphite/80 hover:text-brand-aqua transition-colors block">
                Sand Play Therapy (Caja de Arena)
              </a>
              <a href="/#emdr" class="mobile-nav-link py-1 text-sm text-brand-graphite/80 hover:text-brand-aqua transition-colors block">
                Terapia EMDR
              </a>
            </div>
          </div>

          <a href="/#tarifas" class="mobile-nav-link py-2 border-b border-gray-100 hover:text-brand-aqua transition-colors">Tarifas</a>
          <a href="/#contacto" class="mobile-nav-link py-2 hover:text-brand-aqua transition-colors">Contacto</a>
        </div>
      </nav>
    </header>

    <main class="flex-grow bg-white">
      <slot />
    </main>

    <!-- Barra de llamada flotante en móvil -->
    <FloatingMobileBar />

    <script is:inline>
      document.addEventListener('astro:page-load', () => {
        const toggleBtn = document.getElementById('mobile-menu-toggle');
        const mobileNav = document.getElementById('mobile-nav-menu');
        const iconHamburger = document.getElementById('icon-hamburger');
        const iconClose = document.getElementById('icon-close');
        const navLinks = document.querySelectorAll('.mobile-nav-link');

        if (toggleBtn && mobileNav) {
          toggleBtn.onclick = () => {
            const isOpen = !mobileNav.classList.contains('hidden');
            if (isOpen) {
              mobileNav.classList.add('hidden');
              iconHamburger?.classList.remove('hidden');
              iconClose?.classList.add('hidden');
              toggleBtn.setAttribute('aria-expanded', 'false');
              toggleBtn.setAttribute('aria-label', 'Abrir menú de navegación');
            } else {
              mobileNav.classList.remove('hidden');
              iconHamburger?.classList.add('hidden');
              iconClose?.classList.remove('hidden');
              toggleBtn.setAttribute('aria-expanded', 'true');
              toggleBtn.setAttribute('aria-label', 'Cerrar menú de navegación');
            }
          };

          navLinks.forEach((link) => {
            link.onclick = () => {
              mobileNav.classList.add('hidden');
              iconHamburger?.classList.remove('hidden');
              iconClose?.classList.add('hidden');
              toggleBtn.setAttribute('aria-expanded', 'false');
              toggleBtn.setAttribute('aria-label', 'Abrir menú de navegación');
            };
          });
        }

        // Lógica de Scroll para Desktop: en pantallas grandes (>= 768px), el logo aparece al hacer scroll > 150
        const logoStatic = document.getElementById('logo-static');
        if (logoStatic) {
          const handleLogoScroll = () => {
            if (window.innerWidth >= 768) {
              if (window.scrollY > 150) {
                logoStatic.classList.remove('md:opacity-0', 'md:translate-y-[-10px]');
              } else {
                logoStatic.classList.add('md:opacity-0', 'md:translate-y-[-10px]');
              }
            } else {
              logoStatic.classList.remove('md:opacity-0', 'md:translate-y-[-10px]');
            }
          };

          window.addEventListener('scroll', handleLogoScroll, { passive: true });
          window.addEventListener('resize', handleLogoScroll, { passive: true });
          handleLogoScroll();
        }
      });
    </script>
  </body>
</html>
