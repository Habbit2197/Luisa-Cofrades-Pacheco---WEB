---
import '@fontsource-variable/plus-jakarta-sans';
import '../styles/global.css';
import { ClientRouter as ViewTransitions } from 'astro:transitions';
import FloatingMobileBar from '../components/FloatingMobileBar.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = "Psicología para vivir centro de Luisa Cofrades.",
  description = "¿Cómo podemos ayudarte? Equipo especializado en trauma y experiencias adversas.",
  ogImage = "/assets/branding/logo-luisa-positivo404x.png"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://luisacofrades.com');
---

<!doctype html>
<html lang="es" class="scroll-smooth bg-white text-brand-graphite">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/assets/branding/cropped-logo-simbolo404x.png" />
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Metadatos SEO Primarios -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Luisa Cofrades Pacheco" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Meta de Redes Sociales -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, canonicalURL)} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Psicología para vivir centro de Luisa Cofrades." />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@LCofrades" />
    <meta name="twitter:creator" content="@LCofrades" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, canonicalURL)} />

    <!-- Schema.org JSON-LD para Gabinete Sanitario de Psicología -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "PsychologicalClinic",
        "name": "Psicología para vivir centro de Luisa Cofrades.",
        "image": "https://luisacofrades.com/assets/branding/logo-luisa-positivo404x.png",
        "url": "https://luisacofrades.com",
        "telephone": "+34675809974",
        "priceRange": "$$",
        "address": [
          {
            "@type": "PostalAddress",
            "streetAddress": "Calle del Prior 5-7, 1º B",
            "addressLocality": "Salamanca",
            "postalCode": "37002",
            "addressRegion": "Salamanca",
            "addressCountry": "ES"
          },
          {
            "@type": "PostalAddress",
            "streetAddress": "Roelos de Sayago",
            "addressLocality": "Roelos de Sayago",
            "addressRegion": "Zamora",
            "addressCountry": "ES"
          }
        ],
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": "40.9650",
          "longitude": "-5.6640"
        },
        "openingHours": "Mo-Fr 09:00-20:00",
        "medicalSpecialty": [
          "ClinicalPsychology",
          "Psychotherapy",
          "EMDR"
        ]
      }
    </script>

    <!-- Astro View Transitions para navegación fluida SPA -->
    <ViewTransitions />
  </head>
  <body class="bg-white text-brand-graphite font-sans antialiased selection:bg-brand-aqua/20 selection:text-brand-aqua-dark flex flex-col min-h-screen">
    <!-- Barra superior de navegación corporativa -->
    <header class="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-gray-100 transition-all duration-300">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-20">
          
          <!-- Logo con isotipo multicolor corporativo -->
          <a href="/" class="flex items-center gap-3 group" aria-label="Inicio - Luisa Cofrades">
            <img 
              src="/assets/branding/cropped-logo-simbolo404x.png" 
              alt="Símbolo Luisa Cofrades" 
              width="40"
              height="40"
              loading="eager"
              decoding="async"
              class="w-10 h-10 object-contain rounded-full shadow-sm group-hover:scale-105 transition-transform" 
            />
            <div class="flex flex-col">
              <span class="text-base sm:text-lg font-semibold tracking-tight text-brand-graphite group-hover:text-brand-aqua transition-colors">
                Luisa Cofrades Pacheco
              </span>
              <span class="text-xs uppercase tracking-widest text-brand-aqua font-semibold">
                Psicología para vivir
              </span>
            </div>
          </a>

          <!-- Navegación desktop: exactamente los 5 enlaces solicitados -->
          <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-brand-graphite/80">
            <a href="/" class="hover:text-brand-aqua transition-colors">Inicio</a>
            <a href="/#emdr" class="hover:text-brand-aqua transition-colors">EMDR</a>
            <a href="/#el-centro" class="hover:text-brand-aqua transition-colors">El Centro</a>
            <a href="/#tarifas" class="hover:text-brand-aqua transition-colors">Tarifas</a>
            <a href="/#contacto" class="hover:text-brand-aqua transition-colors">Contacto</a>
          </nav>

          <!-- Acciones de contacto y menú móvil -->
          <div class="flex items-center gap-3">
            <a 
              href="tel:+34675809974" 
              class="hidden sm:inline-flex items-center gap-2 text-sm font-semibold text-brand-aqua hover:text-brand-aqua-dark px-3 py-2 rounded-lg hover:bg-gray-50 transition-colors"
            >
              <svg class="w-4 h-4 text-brand-aqua" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              <span>675 80 99 74</span>
            </a>

            <a 
              href="/#contacto" 
              class="inline-flex items-center justify-center px-4 sm:px-5 py-2.5 rounded-xl bg-brand-aqua hover:bg-brand-aqua-hover text-white text-sm font-medium shadow-sm hover:shadow-card-hover transition-all duration-200"
            >
              Pedir cita
            </a>

            <!-- Botón Hamburguesa Móvil -->
            <button 
              id="mobile-menu-toggle"
              type="button"
              class="md:hidden inline-flex items-center justify-center p-2 rounded-xl text-brand-graphite hover:bg-gray-100 transition-colors"
              aria-controls="mobile-nav-menu"
              aria-expanded="false"
              aria-label="Abrir menú de navegación"
            >
              <svg id="icon-hamburger" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
              <svg id="icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>

        </div>
      </div>

      <!-- Menú Desplegable Móvil -->
      <nav 
        id="mobile-nav-menu" 
        class="hidden md:hidden border-t border-gray-100 bg-white/98 backdrop-blur-md px-6 py-5 shadow-lg"
      >
        <div class="flex flex-col gap-4 text-base font-medium text-brand-graphite">
          <a href="/" class="mobile-nav-link py-2 border-b border-gray-100 hover:text-brand-aqua transition-colors">Inicio</a>
          <a href="/#emdr" class="mobile-nav-link py-2 border-b border-gray-100 hover:text-brand-aqua transition-colors">EMDR</a>
          <a href="/#el-centro" class="mobile-nav-link py-2 border-b border-gray-100 hover:text-brand-aqua transition-colors">El Centro</a>
          <a href="/#tarifas" class="mobile-nav-link py-2 border-b border-gray-100 hover:text-brand-aqua transition-colors">Tarifas</a>
          <a href="/#contacto" class="mobile-nav-link py-2 hover:text-brand-aqua transition-colors">Contacto</a>
        </div>
      </nav>
    </header>

    <main class="flex-grow bg-white">
      <slot />
    </main>

    <!-- Barra de llamada flotante en móvil -->
    <FloatingMobileBar />

    <script is:inline>
      document.addEventListener('astro:page-load', () => {
        const toggleBtn = document.getElementById('mobile-menu-toggle');
        const mobileNav = document.getElementById('mobile-nav-menu');
        const iconHamburger = document.getElementById('icon-hamburger');
        const iconClose = document.getElementById('icon-close');
        const navLinks = document.querySelectorAll('.mobile-nav-link');

        if (toggleBtn && mobileNav) {
          toggleBtn.onclick = () => {
            const isOpen = !mobileNav.classList.contains('hidden');
            if (isOpen) {
              mobileNav.classList.add('hidden');
              iconHamburger?.classList.remove('hidden');
              iconClose?.classList.add('hidden');
              toggleBtn.setAttribute('aria-expanded', 'false');
              toggleBtn.setAttribute('aria-label', 'Abrir menú de navegación');
            } else {
              mobileNav.classList.remove('hidden');
              iconHamburger?.classList.add('hidden');
              iconClose?.classList.remove('hidden');
              toggleBtn.setAttribute('aria-expanded', 'true');
              toggleBtn.setAttribute('aria-label', 'Cerrar menú de navegación');
            }
          };

          navLinks.forEach((link) => {
            link.onclick = () => {
              mobileNav.classList.add('hidden');
              iconHamburger?.classList.remove('hidden');
              iconClose?.classList.add('hidden');
              toggleBtn.setAttribute('aria-expanded', 'false');
              toggleBtn.setAttribute('aria-label', 'Abrir menú de navegación');
            };
          });
        }
      });
    </script>
  </body>
</html>
