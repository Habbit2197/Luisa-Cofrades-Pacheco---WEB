---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import TherapyExplorer from '../components/TherapyExplorer';
import InteractiveTriage from '../components/InteractiveTriage';
import Testimonials from '../components/Testimonials.astro';
import FaqSection from '../components/FaqSection.astro';
import Footer from '../components/Footer.astro';
import AmbientBanner from '../components/AmbientBanner';
import { 
  Award, 
  CheckCircle2, 
  Phone, 
  Mail, 
  MapPin, 
  Calendar, 
  HeartHandshake, 
  BookOpen, 
  ArrowRight, 
  ExternalLink, 
  MessageCircle, 
  FileText, 
  Download, 
  Sparkles, 
  Clock, 
  CreditCard, 
  ClipboardList, 
  Play, 
  ShieldCheck,
  Users,
  GraduationCap
} from 'lucide-react';
import fs from 'node:fs';
import path from 'node:path';

// Cargar artículos para la sección destacada
const dataPath = path.resolve('data.json');
const siteData = JSON.parse(fs.readFileSync(dataPath, 'utf8'));
const postsDestacados = (siteData.posts || []).slice(0, 3);
---

<Layout 
  title="Psicología para vivir centro de Luisa Cofrades." 
  description="¿Cómo podemos ayudarte? Equipo especializado en trauma y experiencias adversas."
>
  <!-- Hero Section con Framer Motion, imagen de la taza/vela y propuesta de valor -->
  <HeroSection />

  <!-- Sección El Equipo (Sustituye a Sobre Mí: Luisa Cofrades y M.ª Paz Urbon) -->
  <section id="el-equipo" class="py-20 sm:py-24 lg:py-28 bg-white border-b border-gray-100 scroll-mt-20">
    <!-- Anclas para compatibilidad de navegación interna -->
    <div id="sobre-mi" class="scroll-mt-20"></div>
    <div id="el-centro" class="scroll-mt-20"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Cabecera de la Sección El Equipo -->
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-aqua/10 text-brand-aqua text-xs font-semibold uppercase tracking-wider border border-brand-aqua/20">
          <Users class="w-4 h-4 text-brand-aqua" />
          <span>El Equipo · Psicología para Vivir</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-light text-brand-graphite tracking-tight leading-tight">
          Profesionales comprometidas con <span class="font-semibold text-brand-aqua">tu bienestar y salud mental</span>
        </h2>
        <p class="text-brand-graphite/75 text-base sm:text-lg leading-relaxed max-w-2xl mx-auto">
          Acompañamiento clínico integral con una <strong class="text-brand-graphite font-semibold">mirada sistémica, humanista e integrativa</strong>, rigor científico y calidez humana en cada proceso terapéutico.
        </p>
      </div>

      <!-- Grid de 2 Columnas para El Equipo (1 col móvil, 2 col desktop) -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-12 items-stretch mb-20 lg:mb-24">
        
        <!-- Tarjeta Profesional 1: Luisa Cofrades Pacheco -->
        <article class="group relative bg-white rounded-[2rem] shadow-lg hover:shadow-2xl transition-all duration-500 hover:-translate-y-2 border border-brand-graphite/5 flex flex-col">
          <!-- Imagen Espectacular con zoom 110% -->
          <div class="relative w-full aspect-[4/5] overflow-hidden rounded-t-[2rem]">
            <img 
              src="/assets/media/Luisa_Art.jpeg" 
              alt="Luisa Cofrades Pacheco - Directora Clínica y Psicóloga General Sanitaria" 
              width="600"
              height="750"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-out"
            />
          </div>

          <!-- La Matrícula Flotante (Sello Oficial) -->
          <div class="relative z-10 px-8">
            <div class="absolute -top-5 left-8 bg-brand-aqua text-white text-xs sm:text-sm font-bold tracking-wide uppercase px-5 py-2.5 rounded-full shadow-xl border-2 border-white">
              N.º Col. BI05747 (COP)
            </div>
          </div>

          <!-- Cuerpo de Texto (Elegancia) -->
          <div class="p-8 pt-8 flex flex-col flex-grow justify-between space-y-6">
            <div class="space-y-4">
              <div>
                <span class="text-xs uppercase tracking-wider text-brand-aqua font-semibold block mb-1">Dirección Clínica & Fundadora</span>
                <h3 class="text-3xl font-bold text-brand-graphite mb-1">
                  Luisa Cofrades Pacheco
                </h3>
                <p class="text-brand-aqua font-medium mb-4">
                  Especialista EuroPsy en Psicoterapia
                </p>
              </div>

              <!-- Biografía en tono gris suave -->
              <div class="space-y-4 text-sm sm:text-base leading-relaxed text-brand-graphite/80">
                <p>
                  Entiendo la psicoterapia como un encuentro profundamente humano y seguro. Un lugar de calma y confidencialidad donde detener el ritmo acelerado del día a día, respirar y ser escuchado con respeto, sin juicios ni etiquetas.
                </p>
                <p>
                  Desarrollo mi intervención clínica desde una <strong class="text-brand-graphite font-semibold">Mirada sistémica, humanista e integrativa</strong>, aunando el rigor neurofisiológico de la <strong class="text-brand-graphite font-semibold">Terapia EMDR</strong> y la <strong class="text-brand-graphite font-semibold">Terapia Sensoriomotriz</strong> con el cuidado del vínculo terapéutico. Pionera en Salamanca en la aplicación de la Caja de Arena (Sand Play) para niños y adultos con trauma complejo.
                </p>
              </div>

              <!-- Acreditaciones en cápsulas -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-2 text-xs font-medium text-brand-graphite">
                <div class="flex items-center gap-2 p-2.5 rounded-xl bg-gray-50 border border-gray-100">
                  <CheckCircle2 class="w-3.5 h-3.5 text-brand-aqua shrink-0" />
                  <span>Colegiada N.º BI05747 (COP)</span>
                </div>
                <div class="flex items-center gap-2 p-2.5 rounded-xl bg-gray-50 border border-gray-100">
                  <CheckCircle2 class="w-3.5 h-3.5 text-brand-aqua shrink-0" />
                  <span>Especialista EuroPsy</span>
                </div>
                <div class="flex items-center gap-2 p-2.5 rounded-xl bg-gray-50 border border-gray-100">
                  <CheckCircle2 class="w-3.5 h-3.5 text-brand-aqua shrink-0" />
                  <span>Asociación EMDR España</span>
                </div>
                <div class="flex items-center gap-2 p-2.5 rounded-xl bg-gray-50 border border-gray-100">
                  <CheckCircle2 class="w-3.5 h-3.5 text-brand-aqua shrink-0" />
                  <span>Docente colaboradora USAL</span>
                </div>
              </div>
            </div>

            <!-- Botón de Cita con Luisa -->
            <div class="pt-6 border-t border-gray-100">
              <a 
                href="#contacto" 
                class="w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-brand-aqua hover:bg-brand-aqua-hover text-white font-medium text-sm transition-all shadow-sm hover:shadow-card-hover"
              >
                <Calendar class="w-4 h-4" />
                <span>Concertar cita con Luisa</span>
              </a>
            </div>
          </div>
        </article>

        <!-- Tarjeta Profesional 2: M.ª Paz Urbón -->
        <article class="group relative bg-white rounded-[2rem] shadow-lg hover:shadow-2xl transition-all duration-500 hover:-translate-y-2 border border-brand-graphite/5 flex flex-col">
          <!-- Imagen Espectacular con zoom 110% -->
          <div class="relative w-full aspect-[4/5] overflow-hidden rounded-t-[2rem]">
            <img 
              src="/assets/media/paz_urbon.jpeg" 
              alt="M.ª Paz Urbón - María de la Paz Palau Urbón, Psicóloga Sanitaria" 
              width="600"
              height="750"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-out"
            />
          </div>

          <!-- La Matrícula Flotante (Sello Oficial) -->
          <div class="relative z-10 px-8">
            <div class="absolute -top-5 left-8 bg-brand-aqua text-white text-xs sm:text-sm font-bold tracking-wide uppercase px-5 py-2.5 rounded-full shadow-xl border-2 border-white">
              N.º Col. CL05542 (COP)
            </div>
          </div>

          <!-- Cuerpo de Texto (Elegancia) -->
          <div class="p-8 pt-8 flex flex-col flex-grow justify-between space-y-6">
            <div class="space-y-4">
              <div>
                <span class="text-xs uppercase tracking-wider text-brand-aqua font-semibold block mb-1">Equipo Clínico Colaborador</span>
                <h3 class="text-3xl font-bold text-brand-graphite mb-1">
                  M.ª Paz Urbón
                </h3>
                <p class="text-brand-aqua font-medium mb-4">
                  Psicóloga General Sanitaria
                </p>
              </div>

              <!-- Biografía en tono gris suave -->
              <div class="space-y-4 text-sm sm:text-base leading-relaxed text-brand-graphite/80">
                <p>
                  Psicóloga General Sanitaria colaboradora en el gabinete, con amplia dedicación y calidez en el acompañamiento psicoterapéutico infanto-juvenil, de familias y personas adultas en procesos de cambio y superación de dificultades emocionales.
                </p>
                <p>
                  Acompaño en la gestión de la ansiedad, el fortalecimiento de la autoestima, la intervención en problemas de conducta y apego, y el restablecimiento de una comunicación familiar saludable, siempre desde la empatía activa, la confidencialidad y la evidencia clínica.
                </p>
              </div>

              <!-- Acreditaciones en cápsulas -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-2 text-xs font-medium text-brand-graphite">
                <div class="flex items-center gap-2 p-2.5 rounded-xl bg-gray-50 border border-gray-100">
                  <CheckCircle2 class="w-3.5 h-3.5 text-brand-aqua shrink-0" />
                  <span>Colegiada N.º CL05542</span>
                </div>
                <div class="flex items-center gap-2 p-2.5 rounded-xl bg-gray-50 border border-gray-100">
                  <CheckCircle2 class="w-3.5 h-3.5 text-brand-aqua shrink-0" />
                  <span>Psicóloga General Sanitaria</span>
                </div>
                <div class="flex items-center gap-2 p-2.5 rounded-xl bg-gray-50 border border-gray-100">
                  <CheckCircle2 class="w-3.5 h-3.5 text-brand-aqua shrink-0" />
                  <span>Atención Infanto-Juvenil</span>
                </div>
                <div class="flex items-center gap-2 p-2.5 rounded-xl bg-gray-50 border border-gray-100">
                  <CheckCircle2 class="w-3.5 h-3.5 text-brand-aqua shrink-0" />
                  <span>Consulta Presencial y Online</span>
                </div>
              </div>
            </div>

            <!-- Botón de Cita con M.ª Paz Urbón -->
            <div class="pt-6 border-t border-gray-100">
              <a 
                href="#contacto" 
                class="w-full inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-white hover:bg-gray-50 text-brand-graphite border border-gray-200 font-medium text-sm transition-all shadow-xs hover:border-brand-aqua"
              >
                <Calendar class="w-4 h-4 text-brand-aqua" />
                <span>Concertar cita con M.ª Paz</span>
              </a>
            </div>
          </div>
        </article>

      </div>

      <!-- Cabecera complementaria del Centro y sus Áreas -->
      <div class="text-center max-w-3xl mx-auto mb-12 space-y-3 pt-6 border-t border-gray-100">
        <span class="text-xs uppercase tracking-wider text-brand-aqua font-semibold">El Centro · Psicología para Vivir</span>
        <h3 class="text-2xl sm:text-3xl font-light text-brand-graphite tracking-tight">
          Un espacio seguro de <span class="font-semibold text-brand-aqua">calma, rigor y crecimiento</span>
        </h3>
        <p class="text-brand-graphite/70 text-sm sm:text-base leading-relaxed">
          Equipo especializado en trauma y experiencias adversas con consulta presencial en Salamanca y atención terapéutica online.
        </p>
      </div>

      <!-- Maquetación en Tres Bloques Limpios (Tarjetas Clínicas) -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Bloque 1: ¿Quiénes Somos? y Espacio Terapéutico -->
        <div class="bg-gray-50 rounded-3xl p-8 sm:p-9 border border-gray-100 shadow-sm hover:shadow-card-hover transition-all duration-300 flex flex-col justify-between">
          <div class="space-y-5">
            <div class="w-12 h-12 rounded-2xl bg-brand-aqua/10 text-brand-aqua flex items-center justify-center">
              <HeartHandshake class="w-6 h-6" />
            </div>

            <div>
              <span class="text-xs uppercase tracking-wider text-brand-aqua font-semibold">Espacio Terapéutico</span>
              <h4 class="text-xl sm:text-2xl font-semibold text-brand-graphite mt-1">
                ¿Quiénes Somos? y Espacio Terapéutico
              </h4>
            </div>

            <!-- Texto literal solicitado -->
            <p class="text-sm sm:text-base text-brand-graphite leading-relaxed text-justify sm:text-left">
              Psicología para vivir es un espacio seguro, diseñado para que te sientas en calma desde el primer momento. Somos un equipo especializado en trauma y experiencias adversas, liderado por Luisa Cofrades. Integramos diferentes corrientes para ofrecerte un tratamiento a medida, siempre desde el rigor científico y la calidez humana.
            </p>
          </div>

          <div class="mt-8 pt-6 border-t border-gray-200/60">
            <div class="flex items-center gap-2 text-xs font-medium text-brand-aqua">
              <CheckCircle2 class="w-4 h-4 text-brand-aqua shrink-0" />
              <span>Colegiada N.º BI05747 · Especialista EuroPsy</span>
            </div>
          </div>
        </div>

        <!-- Bloque 2: Formación y Educación -->
        <div class="bg-gray-50 rounded-3xl p-8 sm:p-9 border border-gray-100 shadow-sm hover:shadow-card-hover transition-all duration-300 flex flex-col justify-between">
          <div class="space-y-5">
            <div class="w-12 h-12 rounded-2xl bg-accent-violet/15 text-[#7C3AED] flex items-center justify-center">
              <BookOpen class="w-6 h-6" />
            </div>

            <div>
              <span class="text-xs uppercase tracking-wider text-[#7C3AED] font-semibold">Grupos y Empresas</span>
              <h4 class="text-xl sm:text-2xl font-semibold text-brand-graphite mt-1">
                Formación y Educación
              </h4>
            </div>

            <!-- Texto literal solicitado -->
            <p class="text-sm sm:text-base text-brand-graphite leading-relaxed text-justify sm:text-left">
              Impartimos formación especializada para grupos y empresas en áreas clave como buenos hábitos, resolución de conflictos, motivación, prevención de adicciones, escuela de padres y comunicación. Adaptamos nuestros talleres para aportar herramientas prácticas y transformadoras.
            </p>
          </div>

          <div class="mt-8 pt-6 border-t border-gray-200/60">
            <div class="flex items-center gap-2 text-xs font-medium text-brand-aqua">
              <CheckCircle2 class="w-4 h-4 text-brand-aqua shrink-0" />
              <span>Docente colaboradora Máster USAL</span>
            </div>
          </div>
        </div>

        <!-- Bloque 3: Supervisión Clínica -->
        <div class="bg-gray-50 rounded-3xl p-8 sm:p-9 border border-gray-100 shadow-sm hover:shadow-card-hover transition-all duration-300 flex flex-col justify-between">
          <div class="space-y-5">
            <div class="w-12 h-12 rounded-2xl bg-accent-sky/20 text-[#0284C7] flex items-center justify-center">
              <Award class="w-6 h-6" />
            </div>

            <div>
              <span class="text-xs uppercase tracking-wider text-[#0284C7] font-semibold">Para Psicólogos</span>
              <h4 class="text-xl sm:text-2xl font-semibold text-brand-graphite mt-1">
                Supervisión Clínica
              </h4>
            </div>

            <!-- Texto literal solicitado -->
            <p class="text-sm sm:text-base text-brand-graphite leading-relaxed text-justify sm:text-left">
              Ofrecemos espacios de supervisión para otros profesionales de la psicología. Un acompañamiento clínico riguroso para analizar casos, resolver bloqueos terapéuticos y seguir creciendo en la práctica profesional con la mirada puesta en el abordaje del trauma.
            </p>
          </div>

          <div class="mt-8 pt-6 border-t border-gray-200/60">
            <div class="flex items-center gap-2 text-xs font-medium text-brand-aqua">
              <CheckCircle2 class="w-4 h-4 text-brand-aqua shrink-0" />
              <span>Especialista Asociación EMDR España</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Grid de Dificultades Emocionales: ¿Cuidamos juntos de tu salud mental? -->
  <section class="py-20 sm:py-24 lg:py-28 bg-brand-aqua/5 border-y border-brand-aqua/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="text-xs uppercase tracking-widest text-brand-aqua font-semibold">Orientación Personalizada</span>
        <h2 class="text-3xl sm:text-4xl font-light text-brand-graphite tracking-tight mt-2">
          ¿Cuidamos juntos de <span class="font-semibold text-brand-aqua">tu salud mental?</span>
        </h2>
        <p class="mt-3 text-brand-graphite/70 text-sm sm:text-base leading-relaxed">
          Identifica la dificultad que estás experimentando para conocer nuestro enfoque de acompañamiento psicoterapéutico:
        </p>
      </div>

      <TherapyExplorer client:visible />
    </div>
  </section>

  <!-- Sección de EMDR: Evidencia Científica, Vídeo Dra. Anabel González y Guía PDF -->
  <section id="emdr" class="py-20 sm:py-24 lg:py-28 bg-white border-b border-gray-100 scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-aqua/10 text-brand-aqua text-xs font-semibold uppercase tracking-wider border border-brand-aqua/20">
          <ShieldCheck class="w-4 h-4 text-brand-aqua" />
          <span>Especialidad Acreditada · Asociación EMDR España</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-light text-brand-graphite tracking-tight">
          Terapia EMDR: <span class="font-semibold text-brand-aqua">Evidencia Científica y Sanación del Trauma</span>
        </h2>
        <p class="text-brand-graphite/70 text-sm sm:text-base leading-relaxed">
          EMDR (Desensibilización y Reprocesamiento por Movimientos Oculares) es un modelo psicoterapéutico neurofisiológico avalado por la Organización Mundial de la Salud (OMS) y las guías clínicas internacionales de mayor prestigio.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        
        <!-- Vídeo Responsivo de YouTube (Dra. Anabel González) -->
        <div class="lg:col-span-7">
          <div class="bg-gray-50 rounded-3xl p-4 sm:p-5 border border-gray-100 shadow-sm">
            <div class="relative w-full aspect-video rounded-2xl overflow-hidden shadow-sm bg-gray-900 border border-gray-200">
              <iframe
                class="w-full h-full absolute inset-0"
                src="https://www.youtube-nocookie.com/embed/GjRkylYH31I"
                title="Evidencia científica de la terapia EMDR - Dra. Anabel González"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
                loading="lazy"
              ></iframe>
            </div>

            <div class="pt-3.5 px-2 flex items-center justify-between text-xs text-brand-graphite/70">
              <span class="flex items-center gap-1.5 font-medium text-brand-aqua">
                <Play class="w-3.5 h-3.5 text-brand-aqua" />
                <span>Vídeo explicativo: Evidencia científica de EMDR</span>
              </span>
              <span>Dra. Anabel González</span>
            </div>
          </div>
        </div>

        <!-- Explicación Clínica y Descarga de la Guía Oficial -->
        <div class="lg:col-span-5 space-y-6">
          <div class="p-6 sm:p-7 rounded-3xl bg-gray-50 border border-gray-100 shadow-sm space-y-4">
            <h3 class="text-xl font-semibold text-brand-graphite">
              ¿Cómo actúa EMDR en tu cerebro?
            </h3>
            <p class="text-sm text-brand-graphite/70 leading-relaxed">
              Cuando vivimos una experiencia dolorosa o traumática, el recuerdo puede quedar congelado en el sistema nervioso con las mismas sensaciones, imágenes y angustia que en el momento original. 
            </p>
            <p class="text-sm text-brand-graphite/70 leading-relaxed">
              Mediante la estimulación bilateral (movimientos oculares o estimulación auditiva/táctil), reactivamos el mecanismo natural de procesamiento adaptativo de la información del cerebro, desactivando la carga emocional dolorosa sin necesidad de revivir el sufrimiento.
            </p>

            <div class="pt-2 border-t border-gray-200/60 space-y-2 text-xs text-brand-graphite font-medium">
              <div class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-brand-aqua" />
                <span>Adultos, adolescentes e infanto-juvenil (Caja de Arena)</span>
              </div>
              <div class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-brand-aqua" />
                <span>Eficaz en trauma simple, complejo, duelos y fobias</span>
              </div>
            </div>
          </div>

          <!-- Botón de Descarga del PDF Oficial -->
          <div class="bg-gradient-to-r from-brand-aqua-dark to-brand-aqua rounded-3xl p-6 text-white shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="space-y-1 text-left">
              <p class="text-xs uppercase tracking-wider text-white/90 font-semibold flex items-center gap-1.5">
                <FileText class="w-3.5 h-3.5" />
                <span>Documento Divulgativo Oficial</span>
              </p>
              <h4 class="text-base font-medium text-white">
                Guía EMDR para pacientes (PDF)
              </h4>
            </div>

            <a 
              href="/assets/documentos/quecc81-es-emdr.pdf" 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-white hover:bg-gray-50 text-brand-aqua font-semibold text-xs sm:text-sm transition-all duration-200 shadow-sm shrink-0 group"
            >
              <Download class="w-4 h-4 text-brand-aqua group-hover:scale-110 transition-transform" />
              <span>Descargar Guía EMDR</span>
            </a>
          </div>

        </div>

      </div>

    </div>
  </section>

  <!-- Grid de Terapias y Servicios Completo -->
  <ServicesGrid />

  <!-- Banner de Ambiente 1: Imagen de respiro y calma antes de Tarifas (Framer Motion scroll fade-in) -->
  <AmbientBanner 
    client:visible
    imageUrl="/assets/media/Luisa_Banner.jpeg" 
    alt="Ambiente acogedor, luz suave y calma" 
    badgeText="Espacio para tu Bienestar"
    quote="Darte un tiempo para ti no es un lujo, es el primer paso para volver a habitar tu vida con serenidad."
