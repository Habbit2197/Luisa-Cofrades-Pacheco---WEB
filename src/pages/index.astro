---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import TherapyExplorer from '../components/TherapyExplorer';
import InteractiveTriage from '../components/InteractiveTriage';
import Testimonials from '../components/Testimonials.astro';
import FaqSection from '../components/FaqSection.astro';
import Footer from '../components/Footer.astro';
import AmbientBanner from '../components/AmbientBanner';
import { 
  Award, 
  CheckCircle2, 
  Phone, 
  Mail, 
  MapPin, 
  Calendar, 
  HeartHandshake, 
  BookOpen, 
  ArrowRight, 
  ExternalLink, 
  MessageCircle, 
  FileText, 
  Download, 
  Sparkles, 
  Clock, 
  CreditCard, 
  ClipboardList, 
  Play, 
  ShieldCheck,
  Users,
  GraduationCap,
  Newspaper
} from 'lucide-react';
import fs from 'node:fs';
import path from 'node:path';

// Cargar artículos para la sección destacada
const dataPath = path.resolve('data.json');
const siteData = JSON.parse(fs.readFileSync(dataPath, 'utf8'));
const postsDestacados = (siteData.posts || []).slice(0, 3);
---

<Layout 
  title="Psicología para vivir centro de Luisa Cofrades." 
  description="¿Cómo podemos ayudarte? Equipo especializado en trauma y experiencias adversas."
>
  <!-- Hero Section con Framer Motion, imagen de la taza/vela y propuesta de valor -->
  <HeroSection />

  <!-- Sección El Equipo (Sustituye a Sobre Mí: Luisa Cofrades y Mari Paz Palau Urbón) -->
  <section id="el-equipo" class="py-20 sm:py-24 lg:py-28 bg-[#f8fbfa] border-b border-gray-100/80 scroll-mt-20">
    <!-- Anclas para compatibilidad de navegación interna -->
    <div id="sobre-mi" class="scroll-mt-20"></div>
    <div id="el-centro" class="scroll-mt-20"></div>
    
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Cabecera de la Sección El Equipo -->
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-aqua/10 text-brand-aqua text-xs font-semibold uppercase tracking-wider border border-brand-aqua/20">
          <Users class="w-4 h-4 text-brand-aqua" />
          <span>El Equipo · Psicología para Vivir</span>
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-light text-brand-graphite tracking-tight leading-tight">
          Profesionales comprometidas con <span class="font-semibold text-brand-aqua">tu bienestar y salud mental</span>
        </h2>
        <p class="text-brand-graphite/75 text-base sm:text-lg leading-relaxed max-w-2xl mx-auto">
          Acompañamiento clínico integral con una <strong class="text-brand-graphite font-semibold">mirada sistémica, humanista e integrativa</strong>, rigor científico y calidez humana en cada proceso terapéutico.
        </p>
      </div>

      <!-- Estructura Jerárquica Asimétrica: Bloque Principal (Luisa) y Bloque Secundario (Colaboradora) -->
      <div class="mb-20 lg:mb-24">
        
        <!-- BLOQUE PRINCIPAL (Luisa Cofrades: Fundadora y Directora) -->
        <article class="w-full flex flex-col lg:flex-row gap-8 lg:gap-12 bg-white p-8 md:p-12 rounded-[2.5rem] shadow-xl border border-gray-100 items-center lg:items-stretch">
          
          <!-- Foto de Luisa con recorte retrato premium -->
          <div class="w-full lg:w-[40%] xl:w-[35%] shrink-0 flex items-center justify-center">
            <img 
              src="/assets/media/luisa_sinperro.jpeg" 
              alt="Luisa Cofrades Pacheco - Directora Clínica y Fundadora" 
              width="600" 
              height="750" 
              loading="lazy" 
              decoding="async" 
              class="w-full aspect-[4/5] max-h-[500px] object-cover object-top rounded-3xl shadow-lg"
            />
          </div>

          <!-- Bloque de texto con jerarquía directiva potente -->
          <div class="flex-1 flex flex-col justify-between space-y-6">
            <div class="space-y-4">
              <div>
                <span class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-brand-aqua/10 text-brand-aqua text-xs sm:text-sm font-bold uppercase tracking-wider border border-brand-aqua/20 mb-3">
                  <Award class="w-4 h-4 text-brand-aqua" />
                  <span>DIRECCIÓN CLÍNICA & FUNDADORA</span>
                </span>
                <h3 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-brand-graphite tracking-tight mb-1">
                  Luisa Cofrades Pacheco
                </h3>
                <p class="text-brand-aqua font-semibold text-base sm:text-lg mb-4">
                  Especialista EuroPsy en Psicoterapia · Psicóloga Sanitaria Colegiada N.º BI05747 (COP)
                </p>
              </div>

              <!-- Biografía en tono gris suave -->
              <div class="space-y-4 text-sm sm:text-base leading-relaxed text-brand-graphite/85 text-justify sm:text-left">
                <p>
                  Entiendo la psicoterapia como un encuentro profundamente humano y seguro. Un lugar de calma y confidencialidad donde detener el ritmo acelerado del día a día, respirar y ser escuchado con respeto, sin juicios ni etiquetas.
                </p>
                <p>
                  Desarrollo mi intervención clínica desde una <strong class="text-brand-graphite font-semibold">mirada sistémica, humanista e integrativa</strong>, aunando el rigor neurofisiológico de la <strong class="text-brand-graphite font-semibold">Terapia EMDR</strong> y la <strong class="text-brand-graphite font-semibold">Terapia Sensoriomotriz</strong> con el cuidado del vínculo terapéutico. Pionera en Salamanca en la aplicación de la Caja de Arena (Sand Play) para niños y adultos con trauma complejo.
                </p>
              </div>

              <!-- Acreditaciones en cápsulas -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-2 text-xs sm:text-sm font-medium text-brand-graphite">
                <div class="flex items-center gap-2 p-2.5 rounded-xl bg-gray-50 border border-gray-100">
                  <CheckCircle2 class="w-4 h-4 text-brand-aqua shrink-0" />
                  <span>Colegiada N.º BI05747 (COP)</span>
                </div>
                <div class="flex items-center gap-2 p-2.5 rounded-xl bg-gray-50 border border-gray-100">
                  <CheckCircle2 class="w-4 h-4 text-brand-aqua shrink-0" />
                  <span>Especialista EuroPsy</span>
                </div>
                <div class="flex items-center gap-2 p-2.5 rounded-xl bg-gray-50 border border-gray-100">
                  <CheckCircle2 class="w-4 h-4 text-brand-aqua shrink-0" />
                  <span>Asociación EMDR España</span>
                </div>
                <div class="flex items-center gap-2 p-2.5 rounded-xl bg-gray-50 border border-gray-100">
                  <CheckCircle2 class="w-4 h-4 text-brand-aqua shrink-0" />
                  <span>Docente colaboradora USAL</span>
                </div>
              </div>
            </div>

            <!-- Botón de Cita con Luisa y Conóceme más -->
            <div class="pt-6 border-t border-gray-100 flex flex-col sm:flex-row items-center gap-4">
              <a 
                href="#contacto" 
                class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-xl bg-brand-aqua hover:bg-brand-aqua-hover text-white font-semibold text-sm transition-all shadow-md hover:shadow-card-hover"
              >
                <Calendar class="w-4 h-4" />
                <span>Concertar cita</span>
              </a>

              <a 
                href="/luisa-cofrades" 
                class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-4 rounded-xl border border-brand-aqua/80 text-brand-aqua hover:bg-brand-aqua/5 font-semibold text-sm transition-all group"
              >
                <span>Conóceme más</span>
                <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
              </a>
            </div>
          </div>
        </article>

        <!-- BLOQUE SECUNDARIO (Colaboradora - Mari Paz Palau Urbón) -->
        <div class="mt-32 md:mt-40 pt-8">
          <h4 class="text-sm font-semibold text-gray-400 tracking-wider uppercase mb-8">
            Colaboradoras del centro
          </h4>

          <article class="max-w-3xl bg-gray-50/70 p-6 md:p-8 rounded-2xl border border-gray-100 flex flex-col md:flex-row gap-6 items-center md:items-start shadow-xs hover:border-gray-200 transition-colors">
            <!-- Foto reducida a avatar circular / miniatura pequeña -->
            <img 
              src="/assets/media/paz_urbon.jpeg" 
              alt="Mari Paz Palau Urbón - Psicóloga General Sanitaria" 
              width="200" 
              height="200" 
              loading="lazy" 
              decoding="async" 
              class="w-24 h-24 md:w-32 md:h-32 rounded-full object-cover shrink-0 shadow-sm border-2 border-white"
            />

            <!-- Contenido con tipografía secundaria y discreta -->
            <div class="flex-1 space-y-3 text-center md:text-left">
              <div>
                <span class="text-xs uppercase tracking-wider text-gray-400 font-semibold block mb-0.5">Equipo Clínico Colaborador</span>
                <h4 class="text-xl font-bold text-brand-graphite">
                  Mari Paz Palau Urbón
                </h4>
                <p class="text-xs sm:text-sm text-brand-aqua font-medium">
                  Psicóloga General Sanitaria · N.º Col. CL-05542
                </p>
              </div>

              <!-- Biografía en tamaño text-sm y color gris suave para marcar segundo plano -->
              <p class="text-xs sm:text-sm text-gray-600 leading-relaxed text-justify md:text-left">
                Psicóloga General Sanitaria. Licenciada en Psicología por la Universidad Pontificia de Salamanca. Terapeuta EMDR y amplia experiencia en terapia cognitivo-conductual. Creo en una psicología cercana y humana, en la que cada persona pueda encontrar un espacio seguro donde sentirse escuchada, comprendida y acompañada. Por eso, quiero ofrecerte un lugar en el que pedas parar, conectar contigo, dar espacio a lo que sientes y, sobre todo, aprender a cuidarte. Un espacio para ti, a tu ritmo.
              </p>

              <!-- Acreditaciones compactas -->
              <div class="pt-1 flex flex-wrap items-center justify-center md:justify-start gap-2 text-xs text-gray-500">
                <span class="px-2.5 py-1 rounded-lg bg-white border border-gray-200">Terapeuta EMDR</span>
                <span class="px-2.5 py-1 rounded-lg bg-white border border-gray-200">Licenciada UPSA</span>
                <span class="px-2.5 py-1 rounded-lg bg-white border border-gray-200">Terapia Cognitivo-Conductual</span>
              </div>

              <!-- Enlace discreto a cita -->
              <div class="pt-2">
                <a 
                  href="#contacto" 
                  class="inline-flex items-center gap-1.5 text-xs font-semibold text-brand-aqua hover:text-brand-aqua-dark transition-colors"
                >
                  <Calendar class="w-3.5 h-3.5" />
                  <span>Concertar cita</span>
                </a>
              </div>
            </div>
          </article>

          <!-- TODO: Añadir tarjetas de Ana y Alba cuando envíen foto y texto -->
        </div>

      </div>

      <!-- Cabecera complementaria del Centro y sus Áreas -->
      <div class="text-center max-w-3xl mx-auto mb-12 space-y-3 pt-6 border-t border-gray-100">
        <span class="text-xs uppercase tracking-wider text-brand-aqua font-semibold">El Centro · Psicología para Vivir</span>
        <h3 class="text-2xl sm:text-3xl font-light text-brand-graphite tracking-tight">
          Un espacio seguro de <span class="font-semibold text-brand-aqua">calma, rigor y crecimiento</span>
        </h3>
        <p class="text-brand-graphite/70 text-sm sm:text-base leading-relaxed">
          Equipo especializado en trauma y experiencias adversas con consulta presencial en Salamanca y atención terapéutica online.
        </p>
      </div>

      <!-- Maquetación en Tres Bloques Limpios (Tarjetas Clínicas) -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        
        <!-- Bloque 1: ¿Quiénes Somos? y Espacio Terapéutico -->
        <div class="bg-white rounded-3xl p-8 sm:p-9 border border-gray-100 shadow-sm hover:shadow-card-hover transition-all duration-300 flex flex-col justify-between">
          <div class="space-y-5">
            <div class="w-12 h-12 rounded-2xl bg-brand-aqua/10 text-brand-aqua flex items-center justify-center">
              <HeartHandshake class="w-6 h-6" />
            </div>

            <div>
              <span class="text-xs uppercase tracking-wider text-brand-aqua font-semibold">Espacio Terapéutico</span>
              <h4 class="text-xl sm:text-2xl font-semibold text-brand-graphite mt-1">
                ¿Quiénes Somos? y Espacio Terapéutico
              </h4>
            </div>

            <!-- Texto literal solicitado -->
            <p class="text-sm sm:text-base text-brand-graphite leading-relaxed text-justify sm:text-left">
              Psicología para vivir es un espacio seguro, diseñado para que te sientas en calma desde el primer momento. Somos un equipo especializado en trauma y experiencias adversas, liderado por Luisa Cofrades. Integramos diferentes corrientes para ofrecerte un tratamiento a medida, siempre desde el rigor científico y la calidez humana.
            </p>
          </div>

          <div class="mt-8 pt-6 border-t border-gray-200/60">
            <div class="flex items-center gap-2 text-xs font-medium text-brand-aqua">
              <CheckCircle2 class="w-4 h-4 text-brand-aqua shrink-0" />
              <span>Colegiada N.º BI05747 · Especialista EuroPsy</span>
            </div>
          </div>
        </div>

        <!-- Bloque 2: Formación y Educación -->
        <div class="bg-white rounded-3xl p-8 sm:p-9 border border-gray-100 shadow-sm hover:shadow-card-hover transition-all duration-300 flex flex-col justify-between">
          <div class="space-y-5">
            <div class="w-12 h-12 rounded-2xl bg-accent-violet/15 text-[#7C3AED] flex items-center justify-center">
              <BookOpen class="w-6 h-6" />
            </div>

            <div>
              <span class="text-xs uppercase tracking-wider text-[#7C3AED] font-semibold">Grupos y Empresas</span>
              <h4 class="text-xl sm:text-2xl font-semibold text-brand-graphite mt-1">
                Formación y Educación
              </h4>
            </div>

            <!-- Texto literal solicitado -->
            <p class="text-sm sm:text-base text-brand-graphite leading-relaxed text-justify sm:text-left">
              Impartimos formación especializada para grupos y empresas en áreas clave como buenos hábitos, resolución de conflictos, motivación, prevención de adicciones, escuela de padres y comunicación. Adaptamos nuestros talleres para aportar herramientas prácticas y transformadoras.
            </p>
          </div>

          <div class="mt-8 pt-6 border-t border-gray-200/60">
            <div class="flex items-center gap-2 text-xs font-medium text-brand-aqua">
              <CheckCircle2 class="w-4 h-4 text-brand-aqua shrink-0" />
              <span>Docente colaboradora Máster USAL</span>
            </div>
          </div>
        </div>

        <!-- Bloque 3: Supervisión Clínica -->
        <div class="bg-white rounded-3xl p-8 sm:p-9 border border-gray-100 shadow-sm hover:shadow-card-hover transition-all duration-300 flex flex-col justify-between">
          <div class="space-y-5">
            <div class="w-12 h-12 rounded-2xl bg-accent-sky/20 text-[#0284C7] flex items-center justify-center">
              <Award class="w-6 h-6" />
            </div>

            <div>
              <span class="text-xs uppercase tracking-wider text-[#0284C7] font-semibold">Para Psicólogos</span>
              <h4 class="text-xl sm:text-2xl font-semibold text-brand-graphite mt-1">
                Supervisión Clínica
              </h4>
            </div>

            <!-- Texto literal solicitado -->
            <p class="text-sm sm:text-base text-brand-graphite leading-relaxed text-justify sm:text-left">
              Ofrecemos espacios de supervisión para otros profesionales de la psicología. Un acompañamiento clínico riguroso para analizar casos, resolver bloqueos terapéuticos y seguir creciendo en la práctica profesional con la mirada puesta en el abordaje del trauma.
            </p>
          </div>

          <div class="mt-8 pt-6 border-t border-gray-200/60">
            <div class="flex items-center gap-2 text-xs font-medium text-brand-aqua">
              <CheckCircle2 class="w-4 h-4 text-brand-aqua shrink-0" />
              <span>Especialista Asociación EMDR España</span>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Pasos para pedir cita y Cuestionario Previo (Accesibilidad UX Inmediata) -->
  <section id="pedir-cita" class="py-16 sm:py-20 bg-gradient-to-b from-gray-50 to-white border-b border-gray-100 scroll-mt-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="bg-white rounded-3xl p-8 sm:p-10 border border-gray-100 shadow-xl shadow-brand-aqua/5 space-y-8">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-gray-100 pb-6">
          <div class="flex items-center gap-3 text-brand-aqua">
            <div class="w-11 h-11 rounded-2xl bg-brand-aqua/10 flex items-center justify-center shrink-0">
              <ClipboardList class="w-6 h-6 text-brand-aqua" />
            </div>
            <div>
              <span class="text-xs font-semibold uppercase tracking-wider text-brand-aqua">Proceso de Acogida</span>
              <h2 class="text-2xl sm:text-3xl font-light text-brand-graphite">
                Pasos para <span class="font-semibold text-brand-aqua">pedir cita</span>
              </h2>
            </div>
          </div>
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-50 text-emerald-800 text-xs font-semibold border border-emerald-100">
            <CheckCircle2 class="w-3.5 h-3.5 text-emerald-600" />
            <span>Atención Presencial en Salamanca y Online</span>
          </div>
        </div>

        <p class="text-sm sm:text-base text-brand-graphite leading-relaxed">
          La consulta presencial se ubica en la <strong>Calle del Prior, número 5-7, 1º B (Salamanca)</strong>. Las sesiones tienen una duración aproximada de una hora (75 €). En la primera sesión se evalúa el caso clínico y se establecen los objetivos terapéuticos.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
          <!-- Paso 1 Obligatorio: Rellenar cuestionario previo -->
          <div class="bg-gray-50 rounded-2xl p-6 border border-gray-200/80 flex flex-col justify-between space-y-4 hover:border-brand-aqua/50 transition-colors">
            <div class="space-y-3">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-aqua/10 text-brand-aqua text-xs font-bold uppercase tracking-wider">
                <span>Paso 1 · Imprescindible</span>
              </div>
              <h3 class="text-lg font-semibold text-brand-graphite">
                Rellenar cuestionario previo
              </h3>
              <p class="text-xs sm:text-sm text-brand-graphite/80 leading-relaxed">
                Antes de iniciar el proceso, te invitamos a completar este formulario confidencial de acogida.
              </p>
              <div class="p-3.5 rounded-xl bg-white border border-gray-200 text-xs text-brand-graphite/85 italic">
                “Para agilizar temas de facturación y aprovechar al máximo el tiempo de sesión.”
              </div>
            </div>

            <div class="pt-2">
              <a 
                href="https://docs.google.com/forms/d/e/1FAIpQLSchCicLOpw2Lt_aJ6FGr4VvUC5wAxPSjW_PoVJtpWAE_4jkMg/viewform" 
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-2 w-full px-5 py-3.5 rounded-xl bg-brand-aqua hover:bg-brand-aqua-hover text-white font-semibold text-xs sm:text-sm shadow-sm hover:shadow-card-hover transition-all"
              >
                <ClipboardList class="w-4 h-4" />
                <span>Rellenar cuestionario previo</span>
                <ExternalLink class="w-3.5 h-3.5 text-white/80" />
              </a>
            </div>
          </div>

          <!-- Paso 2 Obligatorio: Disponibilidad horaria -->
          <div class="bg-gray-50 rounded-2xl p-6 border border-gray-200/80 flex flex-col justify-between space-y-4 hover:border-brand-aqua/50 transition-colors">
            <div class="space-y-3">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-aqua/10 text-brand-aqua text-xs font-bold uppercase tracking-wider">
                <span>Paso 2 · Asignación</span>
              </div>
              <h3 class="text-lg font-semibold text-brand-graphite">
                Disponibilidad horaria
              </h3>
              <!-- Recuadro de aviso con el texto literal solicitado -->
              <div class="p-4 rounded-xl bg-brand-aqua/10 border border-brand-aqua/20 text-xs sm:text-sm text-brand-graphite leading-relaxed">
                <p class="font-semibold text-brand-aqua mb-1">Aviso de asignación y disponibilidad:</p>
                <p class="font-medium">
                  Indica si tu disponibilidad es de mañanas, tardes o flexible. En función de esto y tu motivo de consulta se te asignará el profesional que mejor pueda responder a tu demanda.
                </p>
              </div>
              <p class="text-xs text-brand-graphite/70">
                Así podremos coordinar tu sesión con Luisa Cofrades o con Mari Paz Palau Urbón según la especialidad requerida y la compatibilidad de horarios.
              </p>
            </div>

            <div class="pt-2">
              <a 
                href="#contacto" 
                class="inline-flex items-center justify-center gap-2 w-full px-5 py-3.5 rounded-xl bg-white hover:bg-gray-100 text-brand-graphite border border-gray-200 font-medium text-xs sm:text-sm transition-colors shadow-xs"
              >
                <Calendar class="w-4 h-4 text-brand-aqua" />
                <span>Indicar disponibilidad en el contacto</span>
              </a>
            </div>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- Grid de Dificultades Emocionales: ¿Cuidamos juntos de tu salud mental? -->
  <section class="py-20 sm:py-24 lg:py-28 bg-white border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="text-xs uppercase tracking-widest text-brand-aqua font-semibold">Orientación Personalizada</span>
        <h2 class="text-3xl sm:text-4xl font-light text-brand-graphite tracking-tight mt-2">
          ¿Cuidamos juntos de <span class="font-semibold text-brand-aqua">tu salud mental?</span>
        </h2>
        <p class="mt-3 text-brand-graphite/70 text-sm sm:text-base leading-relaxed">
          Identifica la dificultad que estás experimentando para conocer nuestro enfoque de acompañamiento psicoterapéutico:
        </p>
      </div>

      <TherapyExplorer client:visible />
    </div>
  </section>

  <!-- Sección de EMDR: Evidencia Científica, Vídeo Dra. Anabel González y Guía PDF -->
  <section id="emdr" class="py-20 sm:py-24 lg:py-28 bg-white border-b border-gray-100 scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-aqua/10 text-brand-aqua text-xs font-semibold uppercase tracking-wider border border-brand-aqua/20">
          <ShieldCheck class="w-4 h-4 text-brand-aqua" />
          <span>Especialidad Acreditada · Asociación EMDR España</span>
        </div>
