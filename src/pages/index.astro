---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/HeroSection.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import TherapyExplorer from '../components/TherapyExplorer';
import InteractiveTriage from '../components/InteractiveTriage';
import Testimonials from '../components/Testimonials.astro';
import FaqSection from '../components/FaqSection.astro';
import Footer from '../components/Footer.astro';
import { 
  Award, 
  CheckCircle2, 
  Phone, 
  Mail, 
  MapPin, 
  Calendar, 
  HeartHandshake, 
  BookOpen, 
  ArrowRight, 
  ExternalLink, 
  MessageCircle, 
  FileText, 
  Download, 
  Sparkles, 
  Clock, 
  CreditCard, 
  ClipboardList, 
  Play, 
  ShieldCheck,
  Users,
  GraduationCap
} from 'lucide-react';
import fs from 'node:fs';
import path from 'node:path';

// Cargar artículos para la sección destacada
const dataPath = path.resolve('data.json');
const siteData = JSON.parse(fs.readFileSync(dataPath, 'utf8'));
const postsDestacados = (siteData.posts || []).slice(0, 3);
---

<Layout 
  title="Psicología para vivir centro de Luisa Cofrades." 
  description="¿Cómo podemos ayudarte? Equipo especializado en trauma y experiencias adversas."
>
  <!-- Hero Section con Framer Motion, imagen de la taza/vela y propuesta de valor -->
  <HeroSection />

  <!-- Sección Sobre Mí / El Centro (Bloque de Biografía Premium Split-Screen) -->
  <section id="sobre-mi" class="py-20 sm:py-24 lg:py-28 bg-white border-b border-gray-100 scroll-mt-20">
    <div id="el-centro" class="scroll-mt-20"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Split-screen: Columna Imagen de Luisa + Columna Biografía Personal Brand -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center mb-20 lg:mb-24">
        
        <!-- Columna Imagen -->
        <div class="lg:col-span-5 relative">
          <div class="relative max-w-md mx-auto lg:max-w-none">
            <!-- Aura decorativa de fondo suave en tono brand-aqua -->
            <div class="absolute -inset-4 bg-gradient-to-tr from-brand-aqua/20 to-brand-aqua/5 rounded-3xl -z-10 blur-xl transform -rotate-1 opacity-70"></div>
            
            <!-- Fotografía de Luisa con bordes suaves y sombra -->
            <div class="relative overflow-hidden rounded-2xl shadow-lg border border-gray-100 bg-gray-50">
              <img 
                src="/assets/media/luisa_1.webp" 
                alt="Luisa Cofrades Pacheco - Psicóloga Sanitaria Colegiada" 
                width="600"
                height="750"
                loading="lazy"
                decoding="async"
                class="aspect-[4/5] object-cover rounded-2xl shadow-lg w-full"
              />
            </div>

            <!-- Floating Trust Badge -->
            <div class="absolute -bottom-5 sm:-bottom-6 right-2 sm:right-4 bg-white/95 backdrop-blur-md px-4 py-3 sm:px-5 sm:py-3.5 rounded-2xl shadow-md border border-gray-100 flex items-center gap-3 max-w-[280px] sm:max-w-xs">
              <div class="w-10 h-10 rounded-xl bg-brand-aqua/10 text-brand-aqua flex items-center justify-center shrink-0">
                <ShieldCheck class="w-5 h-5 text-brand-aqua" />
              </div>
              <div>
                <p class="text-xs font-semibold text-brand-graphite">Colegiada N.º BI05747</p>
                <p class="text-[11px] text-brand-aqua font-medium">COP · Acreditación EuroPsy</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Columna Texto: Saludo grande, especialidad en Aqua y espaciado generoso -->
        <div class="lg:col-span-7 space-y-6 text-brand-graphite">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-aqua/10 text-brand-aqua text-xs font-semibold uppercase tracking-wider border border-brand-aqua/20">
            <ShieldCheck class="w-4 h-4 text-brand-aqua" />
            <span>Sobre Mí · Luisa Cofrades</span>
          </div>

          <div class="space-y-2">
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-light text-brand-graphite tracking-tight leading-tight">
              Hola, soy <span class="font-semibold text-brand-aqua">Luisa Cofrades</span>
            </h2>
            <p class="text-lg sm:text-xl font-medium text-brand-aqua">
              Psicóloga General Sanitaria · Especialista en Trauma, EMDR y Enfoque Humanista
            </p>
          </div>

          <!-- Párrafos con espaciado amplio (space-y-6) para dar descanso y lectura zen -->
          <div class="space-y-6 text-base sm:text-lg leading-relaxed text-brand-graphite/85">
            <p>
              Entiendo la psicoterapia como un encuentro profundamente humano y seguro. Un lugar de calma y confidencialidad donde detener el ritmo acelerado del día a día, respirar y ser escuchado/a con respeto, sin juicios ni etiquetas.
            </p>

            <p>
              Con una amplia trayectoria acompañando a personas en momentos de crisis, duelo, dolor y transformación, integro el rigor neurofisiológico de la <strong class="text-brand-graphite font-semibold">Terapia EMDR</strong> y la <strong class="text-brand-graphite font-semibold">Terapia Sensoriomotriz</strong> con una mirada <strong class="text-brand-graphite font-semibold">humanista e integrativa</strong>. Abordamos juntos el origen profundo de los traumas, los patrones de apego y la ansiedad, atendiendo a lo que la mente y el cuerpo expresan.
            </p>

            <p>
              Como <span class="text-brand-aqua font-semibold">Colegiada N.º BI05747</span> y especialista acreditada <strong class="text-brand-graphite font-semibold">EuroPsy</strong> por la Federación Europea de Asociaciones de Psicólogos, mi compromiso es brindarte un acompañamiento riguroso, cálido y personalizado en nuestras consultas presenciales de <strong class="text-brand-graphite font-semibold">Salamanca</strong> y <strong class="text-brand-graphite font-semibold">Zamora</strong>, o a través de la atención <strong class="text-brand-graphite font-semibold">online</strong>.
            </p>
          </div>

          <!-- Acreditaciones en cápsulas Trust Design -->
          <div class="pt-2 grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs sm:text-sm font-medium text-brand-graphite">
            <div class="flex items-center gap-2.5 p-3 rounded-xl bg-gray-50 border border-gray-100">
              <CheckCircle2 class="w-4 h-4 text-brand-aqua shrink-0" />
              <span>Colegiada N.º BI05747 (COP)</span>
            </div>
            <div class="flex items-center gap-2.5 p-3 rounded-xl bg-gray-50 border border-gray-100">
              <CheckCircle2 class="w-4 h-4 text-brand-aqua shrink-0" />
              <span>Especialista EuroPsy en Psicoterapia</span>
            </div>
            <div class="flex items-center gap-2.5 p-3 rounded-xl bg-gray-50 border border-gray-100">
              <CheckCircle2 class="w-4 h-4 text-brand-aqua shrink-0" />
              <span>Asociación EMDR España Acreditada</span>
            </div>
            <div class="flex items-center gap-2.5 p-3 rounded-xl bg-gray-50 border border-gray-100">
              <CheckCircle2 class="w-4 h-4 text-brand-aqua shrink-0" />
              <span>Docente colaboradora Máster USAL</span>
            </div>
          </div>

          <!-- Botones de llamada a la acción -->
          <div class="pt-4 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
            <a 
              href="#contacto" 
              class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-xl bg-brand-aqua hover:bg-brand-aqua-hover text-white font-medium text-sm transition-all shadow-sm hover:shadow-card-hover"
            >
              <Calendar class="w-4 h-4" />
              <span>Concertar cita con Luisa</span>
            </a>
            <a 
              href="#servicios" 
              class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-white hover:bg-gray-50 text-brand-graphite font-medium text-sm border border-gray-200 transition-colors shadow-xs"
            >
              <span>Ver áreas de consulta</span>
              <ArrowRight class="w-4 h-4 text-brand-aqua" />
            </a>
          </div>

        </div>

      </div>

      <!-- Cabecera complementaria del Centro y sus Áreas -->
      <div class="text-center max-w-3xl mx-auto mb-12 space-y-3 pt-6 border-t border-gray-100">
        <span class="text-xs uppercase tracking-wider text-brand-aqua font-semibold">El Centro · Psicología para Vivir</span>
        <h3 class="text-2xl sm:text-3xl font-light text-brand-graphite tracking-tight">
          Un espacio seguro de <span class="font-semibold text-brand-aqua">calma, rigor y crecimiento</span>
        </h3>
        <p class="text-brand-graphite/70 text-sm sm:text-base leading-relaxed">
          Equipo especializado en trauma y experiencias adversas con consultas presenciales en Salamanca y Zamora, y atención terapéutica online.
        </p>
      </div>

      <!-- Maquetación en Tres Bloques Limpios (Tarjetas Clínicas) -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-16">
        
        <!-- Bloque 1: ¿Quiénes Somos? y Espacio Terapéutico -->
        <div class="bg-gray-50 rounded-3xl p-8 sm:p-9 border border-gray-100 shadow-sm hover:shadow-card-hover transition-all duration-300 flex flex-col justify-between">
          <div class="space-y-5">
            <div class="w-12 h-12 rounded-2xl bg-brand-aqua/10 text-brand-aqua flex items-center justify-center">
              <HeartHandshake class="w-6 h-6" />
            </div>

            <div>
              <span class="text-xs uppercase tracking-wider text-brand-aqua font-semibold">Espacio Terapéutico</span>
              <h4 class="text-xl sm:text-2xl font-semibold text-brand-graphite mt-1">
                ¿Quiénes Somos? y Espacio Terapéutico
              </h4>
            </div>

            <!-- Texto literal solicitado -->
            <p class="text-sm sm:text-base text-brand-graphite leading-relaxed text-justify sm:text-left">
              Psicología para vivir es un espacio seguro, diseñado para que te sientas en calma desde el primer momento. Somos un equipo especializado en trauma y experiencias adversas, liderado por Luisa Cofrades. Integramos diferentes corrientes para ofrecerte un tratamiento a medida, siempre desde el rigor científico y la calidez humana.
            </p>
          </div>

          <div class="mt-8 pt-6 border-t border-gray-200/60">
            <div class="flex items-center gap-2 text-xs font-medium text-brand-aqua">
              <CheckCircle2 class="w-4 h-4 text-brand-aqua shrink-0" />
              <span>Colegiada N.º BI05747 · Especialista EuroPsy</span>
            </div>
          </div>
        </div>

        <!-- Bloque 2: Formación y Educación -->
        <div class="bg-gray-50 rounded-3xl p-8 sm:p-9 border border-gray-100 shadow-sm hover:shadow-card-hover transition-all duration-300 flex flex-col justify-between">
          <div class="space-y-5">
            <div class="w-12 h-12 rounded-2xl bg-accent-violet/15 text-[#7C3AED] flex items-center justify-center">
              <BookOpen class="w-6 h-6" />
            </div>

            <div>
              <span class="text-xs uppercase tracking-wider text-[#7C3AED] font-semibold">Grupos y Empresas</span>
              <h4 class="text-xl sm:text-2xl font-semibold text-brand-graphite mt-1">
                Formación y Educación
              </h4>
            </div>

            <!-- Texto literal solicitado -->
            <p class="text-sm sm:text-base text-brand-graphite leading-relaxed text-justify sm:text-left">
              Impartimos formación especializada para grupos y empresas en áreas clave como buenos hábitos, resolución de conflictos, motivación, prevención de adicciones, escuela de padres y comunicación. Adaptamos nuestros talleres para aportar herramientas prácticas y transformadoras.
            </p>
          </div>

          <div class="mt-8 pt-6 border-t border-gray-200/60">
            <div class="flex items-center gap-2 text-xs font-medium text-brand-aqua">
              <CheckCircle2 class="w-4 h-4 text-brand-aqua shrink-0" />
              <span>Docente colaboradora Máster USAL</span>
            </div>
          </div>
        </div>

        <!-- Bloque 3: Supervisión Clínica -->
        <div class="bg-gray-50 rounded-3xl p-8 sm:p-9 border border-gray-100 shadow-sm hover:shadow-card-hover transition-all duration-300 flex flex-col justify-between">
          <div class="space-y-5">
            <div class="w-12 h-12 rounded-2xl bg-accent-sky/20 text-[#0284C7] flex items-center justify-center">
              <Award class="w-6 h-6" />
            </div>

            <div>
              <span class="text-xs uppercase tracking-wider text-[#0284C7] font-semibold">Para Psicólogos</span>
              <h4 class="text-xl sm:text-2xl font-semibold text-brand-graphite mt-1">
                Supervisión Clínica
              </h4>
            </div>

            <!-- Texto literal solicitado -->
            <p class="text-sm sm:text-base text-brand-graphite leading-relaxed text-justify sm:text-left">
              Ofrecemos espacios de supervisión para otros profesionales de la psicología. Un acompañamiento clínico riguroso para analizar casos, resolver bloqueos terapéuticos y seguir creciendo en la práctica profesional con la mirada puesta en el abordaje del trauma.
            </p>
          </div>

          <div class="mt-8 pt-6 border-t border-gray-200/60">
            <div class="flex items-center gap-2 text-xs font-medium text-brand-aqua">
              <CheckCircle2 class="w-4 h-4 text-brand-aqua shrink-0" />
              <span>Especialista Asociación EMDR España</span>
            </div>
          </div>
        </div>

      </div>

      <!-- Barra complementaria de credenciales y acceso al gabinete -->
      <div class="bg-gray-50 rounded-3xl p-6 sm:p-8 border border-gray-100 flex flex-col md:flex-row items-center justify-between gap-6 shadow-sm">
        <div class="flex items-center gap-4">
          <img 
            src="/assets/media/la-puerta.jpg" 
            alt="Entrada al gabinete de psicología de Luisa Cofrades" 
            width="80"
            height="80"
            loading="lazy"
            decoding="async"
            class="w-16 h-16 sm:w-20 sm:h-20 object-cover rounded-2xl border border-gray-200 shrink-0"
          />
          <div>
            <h4 class="text-base font-semibold text-brand-graphite">Luisa A. Cofrades Pacheco</h4>
            <p class="text-xs text-brand-aqua font-medium">Psicóloga Sanitaria Colegiada N.º BI05747 (COP) · EuroPsy</p>
            <p class="text-xs text-brand-graphite/70 mt-0.5">Consultas en Salamanca Centro, Roelos de Sayago (Zamora) y atención online.</p>
          </div>
        </div>

        <div class="shrink-0 flex items-center gap-3">
          <a 
            href="#contacto" 
            class="px-5 py-2.5 rounded-xl bg-brand-aqua hover:bg-brand-aqua-hover text-white text-xs sm:text-sm font-medium transition-colors shadow-sm"
          >
            Concertar cita o supervisión
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- Grid de Dificultades Emocionales: ¿Cuidamos juntos de tu salud mental? -->
  <section class="py-20 sm:py-24 lg:py-28 bg-white border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="text-xs uppercase tracking-widest text-brand-aqua font-semibold">Orientación Personalizada</span>
        <h2 class="text-3xl sm:text-4xl font-light text-brand-graphite tracking-tight mt-2">
          ¿Cuidamos juntos de <span class="font-semibold text-brand-aqua">tu salud mental?</span>
        </h2>
        <p class="mt-3 text-brand-graphite/70 text-sm sm:text-base leading-relaxed">
          Identifica la dificultad que estás experimentando para conocer nuestro enfoque de acompañamiento psicoterapéutico:
        </p>
      </div>

      <TherapyExplorer client:visible />
    </div>
  </section>

  <!-- Sección de EMDR: Evidencia Científica, Vídeo Dra. Anabel González y Guía PDF -->
  <section id="emdr" class="py-20 sm:py-24 lg:py-28 bg-white border-b border-gray-100 scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-16 space-y-3">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-aqua/10 text-brand-aqua text-xs font-semibold uppercase tracking-wider border border-brand-aqua/20">
          <ShieldCheck class="w-4 h-4 text-brand-aqua" />
          <span>Especialidad Acreditada · Asociación EMDR España</span>
        </div>
        <h2 class="text-3xl sm:text-4xl font-light text-brand-graphite tracking-tight">
          Terapia EMDR: <span class="font-semibold text-brand-aqua">Evidencia Científica y Sanación del Trauma</span>
        </h2>
        <p class="text-brand-graphite/70 text-sm sm:text-base leading-relaxed">
          EMDR (Desensibilización y Reprocesamiento por Movimientos Oculares) es un modelo psicoterapéutico neurofisiológico avalado por la Organización Mundial de la Salud (OMS) y las guías clínicas internacionales de mayor prestigio.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        
        <!-- Vídeo Responsivo de YouTube (Dra. Anabel González) -->
        <div class="lg:col-span-7">
          <div class="bg-gray-50 rounded-3xl p-4 sm:p-5 border border-gray-100 shadow-sm">
            <div class="relative w-full aspect-video rounded-2xl overflow-hidden shadow-sm bg-gray-900 border border-gray-200">
              <iframe
                class="w-full h-full absolute inset-0"
                src="https://www.youtube-nocookie.com/embed/GjRkylYH31I"
                title="Evidencia científica de la terapia EMDR - Dra. Anabel González"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                allowfullscreen
                loading="lazy"
              ></iframe>
            </div>

            <div class="pt-3.5 px-2 flex items-center justify-between text-xs text-brand-graphite/70">
              <span class="flex items-center gap-1.5 font-medium text-brand-aqua">
                <Play class="w-3.5 h-3.5 text-brand-aqua" />
                <span>Vídeo explicativo: Evidencia científica de EMDR</span>
              </span>
              <span>Dra. Anabel González</span>
            </div>
          </div>
        </div>

        <!-- Explicación Clínica y Descarga de la Guía Oficial -->
        <div class="lg:col-span-5 space-y-6">
          <div class="p-6 sm:p-7 rounded-3xl bg-gray-50 border border-gray-100 shadow-sm space-y-4">
            <h3 class="text-xl font-semibold text-brand-graphite">
              ¿Cómo actúa EMDR en tu cerebro?
            </h3>
            <p class="text-sm text-brand-graphite/70 leading-relaxed">
              Cuando vivimos una experiencia dolorosa o traumática, el recuerdo puede quedar congelado en el sistema nervioso con las mismas sensaciones, imágenes y angustia que en el momento original. 
            </p>
            <p class="text-sm text-brand-graphite/70 leading-relaxed">
              Mediante la estimulación bilateral (movimientos oculares o estimulación auditiva/táctil), reactivamos el mecanismo natural de procesamiento adaptativo de la información del cerebro, desactivando la carga emocional dolorosa sin necesidad de revivir el sufrimiento.
            </p>

            <div class="pt-2 border-t border-gray-200/60 space-y-2 text-xs text-brand-graphite font-medium">
              <div class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-brand-aqua" />
                <span>Adultos, adolescentes e infanto-juvenil (Caja de Arena)</span>
              </div>
              <div class="flex items-center gap-2">
                <CheckCircle2 class="w-4 h-4 text-brand-aqua" />
                <span>Eficaz en trauma simple, complejo, duelos y fobias</span>
              </div>
            </div>
          </div>

          <!-- Botón de Descarga del PDF Oficial -->
          <div class="bg-gradient-to-r from-brand-aqua-dark to-brand-aqua rounded-3xl p-6 text-white shadow-sm flex flex-col sm:flex-row items-center justify-between gap-4">
            <div class="space-y-1 text-left">
              <p class="text-xs uppercase tracking-wider text-white/90 font-semibold flex items-center gap-1.5">
                <FileText class="w-3.5 h-3.5" />
                <span>Documento Divulgativo Oficial</span>
              </p>
              <h4 class="text-base font-medium text-white">
                Guía EMDR para pacientes (PDF)
              </h4>
            </div>

            <a 
              href="/assets/documentos/quecc81-es-emdr.pdf" 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-white hover:bg-gray-50 text-brand-aqua font-semibold text-xs sm:text-sm transition-all duration-200 shadow-sm shrink-0 group"
            >
              <Download class="w-4 h-4 text-brand-aqua group-hover:scale-110 transition-transform" />
              <span>Descargar Guía EMDR</span>
            </a>
          </div>

        </div>

      </div>

    </div>
  </section>

  <!-- Grid de Terapias y Servicios Completo -->
  <ServicesGrid />

  <!-- Banner de Ambiente 1: Imagen de respiro y calma antes de Tarifas -->
  <section class="relative overflow-hidden py-24 sm:py-28 min-h-[360px] flex items-center justify-center text-center">
    <!-- Fotografía Unsplash de calma y serenidad -->
    <img 
      src="https://images.unsplash.com/photo-1499209974431-9dddcece7f88?auto=format&fit=crop&w=1920&q=80" 
      alt="Ambiente acogedor, luz suave y calma" 
      width="1920"
      height="800"
      loading="lazy"
      decoding="async"
      class="absolute inset-0 w-full h-full object-cover object-center"
    />
    <!-- Overlay con brand-aqua al 20% y contraste para legibilidad limpia -->
    <div class="absolute inset-0 bg-brand-graphite/45 mix-blend-multiply"></div>
    <div class="absolute inset-0 bg-brand-aqua/20"></div>

    <!-- Contenido del Banner -->
    <div class="relative z-10 max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-white space-y-4">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/20 backdrop-blur-md text-white text-xs font-semibold uppercase tracking-wider border border-white/30">
        <Sparkles class="w-3.5 h-3.5 text-white" />
        <span>Espacio para tu Bienestar</span>
      </div>
      <p class="text-2xl sm:text-3xl md:text-4xl font-light tracking-tight leading-snug drop-shadow-sm">
        "Darte un tiempo para ti no es un lujo, es el primer paso para volver a habitar tu vida con serenidad."
      </p>
      <p class="text-sm sm:text-base text-white/90 max-w-xl mx-auto font-normal">
        Atención cuidada, personalizada y sin prisas en un clima de confianza mutua.
      </p>
    </div>
  </section>

  <!-- Sección de Tarifas y Cuestionario Previo de la Clienta -->
  <section id="tarifas" class="py-20 sm:py-24 lg:py-28 bg-gray-50/60 border-b border-gray-100 scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="text-xs uppercase tracking-widest text-brand-aqua font-semibold">Claridad y Transparencia</span>
        <h2 class="text-3xl sm:text-4xl font-light text-brand-graphite tracking-tight mt-2">
          Tarifas y <span class="font-semibold text-brand-aqua">Honorarios de Consulta</span>
