                  <span class="text-[11px] text-gray-500 mb-2 block">Icono o símbolo de cabecera</span>
                  <div class="w-full aspect-video rounded-xl bg-gray-200 overflow-hidden border border-gray-200 mb-3 flex items-center justify-center p-2 bg-white">
                    <img id="preview_img_logo" src="" alt="Logo preview" class="max-h-full max-w-full object-contain" />
