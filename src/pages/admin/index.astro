---
export const prerender = false;

import { getSiteConfig } from '../../lib/siteConfig';

const config = await getSiteConfig();
---

<!doctype html>
<html lang="es" class="h-full bg-[#f8faf9]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Panel de Administración | Luisa Cofrades</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script id="config-data" type="application/json" set:html={JSON.stringify(config)} />
  </head>
  <body class="h-full text-[#2D3748] font-sans antialiased bg-[#f8faf9] flex flex-col">
    
    <!-- Top Sticky Header -->
    <header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-gray-200 shadow-xs">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        
        <!-- Left: Brand / Title -->
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-teal-500/15 flex items-center justify-center text-teal-700 font-bold text-base border border-teal-500/25">
            LC
          </div>
          <div>
            <div class="flex items-center gap-2">
              <h1 class="text-sm sm:text-base font-semibold text-gray-800 leading-tight">
                Panel CMS
              </h1>
              <span class="text-[10px] uppercase font-bold tracking-wider px-2 py-0.5 rounded-full bg-teal-50 text-teal-700 border border-teal-200">
                v2.0
              </span>
            </div>
            <p class="text-[11px] text-gray-500 hidden sm:block">
              Psicología para vivir · Luisa Cofrades
            </p>
          </div>
        </div>

        <!-- Center: Status Badge -->
        <div class="flex items-center gap-2">
          <div id="statusBadge" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200 transition-all">
            <span id="statusDot" class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span id="statusText">Todos los cambios guardados</span>
          </div>
        </div>

        <!-- Right: Actions -->
        <div class="flex items-center gap-2 sm:gap-3">
          <a
            href="/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-medium text-gray-600 hover:text-teal-700 hover:bg-gray-100 transition-colors"
            title="Ver la página web en una nueva pestaña"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
            <span class="hidden md:inline">Ver web</span>
          </a>

          <button
            type="button"
            id="openResetModalBtn"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-medium text-amber-700 bg-amber-50 hover:bg-amber-100 border border-amber-200 transition-colors"
            title="Restaurar toda la configuración a los valores por defecto del sistema"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
            <span class="hidden lg:inline">Restaurar valores</span>
          </button>

          <a
            href="/cdn-cgi/access/logout"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-medium text-gray-600 hover:text-red-700 hover:bg-red-50 border border-gray-200 hover:border-red-200 transition-colors"
            title="Cerrar sesión de Cloudflare Access"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
            </svg>
            <span class="hidden sm:inline">Cerrar sesión</span>
          </a>

          <button
            type="button"
            id="saveAllBtn"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-teal-600 hover:bg-teal-700 text-white font-semibold text-xs sm:text-sm shadow-sm transition-all duration-200 disabled:opacity-50"
          >
            <svg id="saveSpinner" class="hidden animate-spin w-4 h-4 text-white" fill="none" viewBox="0 0 24 24">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
            </svg>
            <span id="saveText">Guardar cambios</span>
          </button>
        </div>

      </div>
    </header>

    <!-- Main Container: Sidebar + Content -->
    <div class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 flex flex-col md:flex-row gap-8 items-start">
      
      <!-- Left Sidebar (Desktop) / Tab Navigation -->
      <aside class="w-full md:w-64 shrink-0 md:sticky md:top-24 bg-white rounded-3xl p-3 border border-gray-200/80 shadow-xs space-y-1">
        <p class="px-3 pt-2 pb-1 text-[11px] font-bold uppercase tracking-wider text-gray-400">
          Secciones de la Web
        </p>
        
        <button
          type="button"
          data-tab="tab-aviso-hero"
          class="nav-tab active w-full flex items-center gap-3 px-3 py-2.5 rounded-2xl text-xs sm:text-sm font-semibold transition-all text-left bg-teal-50 text-teal-800"
        >
          <svg class="w-4 h-4 shrink-0 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
          </svg>
          <span>Aviso y Portada</span>
        </button>

        <button
          type="button"
          data-tab="tab-equipo-about"
          class="nav-tab w-full flex items-center gap-3 px-3 py-2.5 rounded-2xl text-xs sm:text-sm font-semibold transition-all text-left text-gray-600 hover:bg-gray-50 hover:text-gray-900"
        >
          <svg class="w-4 h-4 shrink-0 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <span>Equipo y Sobre mí</span>
        </button>

        <button
          type="button"
          data-tab="tab-servicios"
          class="nav-tab w-full flex items-center gap-3 px-3 py-2.5 rounded-2xl text-xs sm:text-sm font-semibold transition-all text-left text-gray-600 hover:bg-gray-50 hover:text-gray-900"
        >
          <svg class="w-4 h-4 shrink-0 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
          </svg>
          <span>Servicios (Flip Cards)</span>
        </button>

        <button
          type="button"
          data-tab="tab-tarifas"
          class="nav-tab w-full flex items-center gap-3 px-3 py-2.5 rounded-2xl text-xs sm:text-sm font-semibold transition-all text-left text-gray-600 hover:bg-gray-50 hover:text-gray-900"
        >
          <svg class="w-4 h-4 shrink-0 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span>Tarifas</span>
        </button>

        <button
          type="button"
          data-tab="tab-citas-contacto"
          class="nav-tab w-full flex items-center gap-3 px-3 py-2.5 rounded-2xl text-xs sm:text-sm font-semibold transition-all text-left text-gray-600 hover:bg-gray-50 hover:text-gray-900"
        >
          <svg class="w-4 h-4 shrink-0 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          <span>Cita y Contacto</span>
        </button>

        <button
          type="button"
          data-tab="tab-imagenes-seo"
          class="nav-tab w-full flex items-center gap-3 px-3 py-2.5 rounded-2xl text-xs sm:text-sm font-semibold transition-all text-left text-gray-600 hover:bg-gray-50 hover:text-gray-900"
        >
          <svg class="w-4 h-4 shrink-0 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          <span>Imágenes y SEO</span>
        </button>

        <div class="pt-4 px-2">
          <div class="p-3 rounded-2xl bg-gray-50 border border-gray-100 text-[11px] text-gray-500 space-y-1">
            <p class="font-semibold text-gray-700">Atajo de teclado:</p>
            <p><kbd class="px-1.5 py-0.5 bg-white border border-gray-200 rounded text-[10px] font-mono">Ctrl+S</kbd> o <kbd class="px-1.5 py-0.5 bg-white border border-gray-200 rounded text-[10px] font-mono">⌘S</kbd> para guardar.</p>
          </div>
        </div>
      </aside>

      <!-- Right Main Content Area -->
      <main class="flex-1 w-full space-y-8 pb-20">
        
        <!-- SECTION 1: Aviso y Portada -->
        <div id="tab-aviso-hero" class="tab-pane space-y-8">
          
          <!-- Banner Superior de Aviso -->
          <section class="bg-white rounded-3xl p-6 sm:p-8 border border-gray-200/80 shadow-xs space-y-6">
            <div class="flex items-center justify-between border-b border-gray-100 pb-4">
              <div>
                <h3 class="text-base sm:text-lg font-semibold text-gray-800">
                  Aviso Importante (Banner Superior en Portada)
                </h3>
                <p class="text-xs text-gray-500">
                  Muestra un banner superior en toda la portada para vacaciones, avisos o novedades.
                </p>
              </div>

              <!-- Switch -->
              <label class="relative inline-flex items-center cursor-pointer select-none">
                <input
                  type="checkbox"
                  id="banner_active"
                  class="sr-only peer"
                />
                <div class="w-11 h-6 bg-gray-200 peer-focus:outline-hidden rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-teal-600"></div>
                <span class="ml-2.5 text-xs font-semibold text-gray-700 hidden sm:inline" id="bannerActiveLabel">
                  Desactivado
                </span>
              </label>
            </div>

            <div class="space-y-4">
              <div>
                <label for="banner_message" class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1.5">
                  Mensaje del aviso
                </label>
                <input
                  type="text"
                  id="banner_message"
                  placeholder="Ej: La consulta permanecerá cerrada por vacaciones del 1 al 15 de agosto. Puedes pedir cita previa para septiembre."
                  class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 text-sm text-gray-800 outline-hidden"
                />
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="banner_linkText" class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1.5">
                    Texto del enlace (opcional)
                  </label>
                  <input
                    type="text"
                    id="banner_linkText"
                    placeholder="Ej: Más información o Pedir cita"
                    class="w-full px-4 py-2 rounded-xl border border-gray-200 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 text-sm text-gray-800 outline-hidden"
                  />
                </div>
                <div>
                  <label for="banner_linkUrl" class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1.5">
                    URL del enlace (opcional)
                  </label>
                  <input
                    type="text"
                    id="banner_linkUrl"
                    placeholder="Ej: #contacto o https://..."
                    class="w-full px-4 py-2 rounded-xl border border-gray-200 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 text-sm text-gray-800 outline-hidden"
                  />
                </div>
              </div>
            </div>
          </section>

          <!-- Hero Section (Portada Principal) -->
          <section class="bg-white rounded-3xl p-6 sm:p-8 border border-gray-200/80 shadow-xs space-y-6">
            <div class="border-b border-gray-100 pb-4">
              <h3 class="text-base sm:text-lg font-semibold text-gray-800">
                Sección Hero (Portada Principal)
              </h3>
              <p class="text-xs text-gray-500">
                Textos principales, badges y llamadas a la acción en la cabecera de la web.
              </p>
            </div>

            <div class="space-y-4">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="hero_title" class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1.5">
                    Título principal
                  </label>
                  <input
                    type="text"
                    id="hero_title"
                    class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 text-sm font-medium text-gray-800 outline-hidden"
                  />
                </div>
                <div>
                  <label for="hero_titleHighlight" class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1.5">
                    Título resaltado (en color aguamarina)
                  </label>
                  <input
                    type="text"
                    id="hero_titleHighlight"
                    class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 text-sm font-semibold text-teal-700 outline-hidden"
                  />
                </div>
              </div>

              <div>
                <label for="hero_subtitle" class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1.5">
                  Subtítulo descriptivo
                </label>
                <textarea
                  id="hero_subtitle"
                  rows="3"
                  class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 text-sm text-gray-800 outline-hidden leading-relaxed"
                ></textarea>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="hero_badge" class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1.5">
                    Badge superior (Acreditación)
                  </label>
                  <input
                    type="text"
                    id="hero_badge"
                    class="w-full px-4 py-2 rounded-xl border border-gray-200 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 text-xs sm:text-sm text-gray-800 outline-hidden"
                  />
                </div>
                <div>
                  <label for="hero_registryNotice" class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1.5">
                    Registro Sanitario y Colegiación
                  </label>
                  <input
                    type="text"
                    id="hero_registryNotice"
                    class="w-full px-4 py-2 rounded-xl border border-gray-200 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 text-xs sm:text-sm text-gray-800 outline-hidden"
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 pt-2 border-t border-gray-100">
                <div>
                  <label for="hero_ctaText" class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1.5">
                    Texto Botón Principal (CTA)
                  </label>
                  <input
                    type="text"
                    id="hero_ctaText"
                    class="w-full px-4 py-2 rounded-xl border border-gray-200 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 text-xs sm:text-sm text-gray-800 outline-hidden"
                  />
                </div>
                <div>
                  <label for="hero_ctaLink" class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1.5">
                    Enlace Botón Principal
                  </label>
                  <input
                    type="text"
                    id="hero_ctaLink"
                    class="w-full px-4 py-2 rounded-xl border border-gray-200 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 text-xs sm:text-sm text-gray-800 outline-hidden"
                  />
                </div>
                <div>
                  <label for="hero_phoneText" class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1.5">
                    Teléfono en Hero
                  </label>
                  <input
                    type="text"
                    id="hero_phoneText"
                    class="w-full px-4 py-2 rounded-xl border border-gray-200 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 text-xs sm:text-sm text-gray-800 outline-hidden"
                  />
                </div>
              </div>
            </div>
          </section>

        </div>

        <!-- SECTION 2: Equipo y Sobre mí -->
        <div id="tab-equipo-about" class="tab-pane hidden space-y-8">
          
          <!-- Sobre mí: Luisa Cofrades -->
          <section class="bg-white rounded-3xl p-6 sm:p-8 border border-gray-200/80 shadow-xs space-y-6">
            <div class="border-b border-gray-100 pb-4">
              <h3 class="text-base sm:text-lg font-semibold text-gray-800">
                Dirección Clínica & Sobre mí (Luisa Cofrades)
              </h3>
              <p class="text-xs text-gray-500">
                Textos, biografía y títulos oficiales de Luisa Cofrades Pacheco.
              </p>
            </div>

            <div class="space-y-4">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="about_luisaName" class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1.5">
                    Nombre completo
                  </label>
                  <input
                    type="text"
                    id="about_luisaName"
                    class="w-full px-4 py-2 rounded-xl border border-gray-200 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 text-sm font-semibold text-gray-800 outline-hidden"
                  />
                </div>
                <div>
                  <label for="about_luisaRole" class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1.5">
                    Cargo y Acreditación Principal
                  </label>
                  <input
                    type="text"
                    id="about_luisaRole"
                    class="w-full px-4 py-2 rounded-xl border border-gray-200 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 text-sm text-gray-800 outline-hidden"
                  />
                </div>
              </div>

              <div>
                <label for="about_luisaRegNotice" class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1.5">
                  Número de Registro Sanitario CyL
                </label>
                <input
                  type="text"
                  id="about_luisaRegNotice"
                  class="w-full px-4 py-2 rounded-xl border border-gray-200 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 text-sm text-gray-800 outline-hidden"
                />
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="about_luisaBio1" class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1.5">
                    Biografía (Párrafo 1)
                  </label>
                  <textarea
                    id="about_luisaBio1"
                    rows="4"
                    class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 text-xs sm:text-sm text-gray-800 outline-hidden leading-relaxed"
                  ></textarea>
                </div>
                <div>
                  <label for="about_luisaBio2" class="block text-xs font-semibold uppercase tracking-wider text-gray-700 mb-1.5">
                    Biografía (Párrafo 2)
                  </label>
                  <textarea
                    id="about_luisaBio2"
                    rows="4"
                    class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:border-teal-500 focus:ring-2 focus:ring-teal-500/20 text-xs sm:text-sm text-gray-800 outline-hidden leading-relaxed"
                  ></textarea>
                </div>
              </div>
            </div>
          </section>

          <!-- Equipo Clínico Colaborador (Dynamic List CRUD) -->
          <section class="bg-white rounded-3xl p-6 sm:p-8 border border-gray-200/80 shadow-xs space-y-6">
            <div class="flex items-center justify-between border-b border-gray-100 pb-4">
              <div>
                <h3 class="text-base sm:text-lg font-semibold text-gray-800">
                  Equipo Clínico Colaborador
                </h3>
                <p class="text-xs text-gray-500">
                  Añade, edita, ordena con las flechas o elimina psicólogas del equipo.
                </p>
              </div>

              <button
                type="button"
                id="addTeamBtn"
                class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-teal-600 hover:bg-teal-700 text-white font-semibold text-xs transition-colors shadow-xs"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
