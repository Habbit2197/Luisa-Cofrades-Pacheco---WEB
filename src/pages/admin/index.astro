      </main>

    </div>

    <!-- Modal de Confirmación para Restaurar Valores por Defecto -->
    <div id="resetModal" class="fixed inset-0 z-50 bg-gray-900/50 backdrop-blur-xs flex items-center justify-center p-4 hidden">
      <div class="bg-white rounded-3xl max-w-md w-full p-6 sm:p-7 shadow-2xl border border-gray-100 space-y-5 animate-in fade-in zoom-in-95 duration-200">
        <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center border border-amber-200/60">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </div>

        <div>
          <h4 class="text-lg font-bold text-gray-900">
            ¿Restaurar valores por defecto?
          </h4>
          <p class="text-xs sm:text-sm text-gray-600 mt-1 leading-relaxed">
            Esta acción restablecerá todas las tarifas, textos, equipo y configuraciones a los valores oficiales predeterminados. Los cambios no guardados se perderán.
          </p>
        </div>

        <div class="flex items-center justify-end gap-3 pt-2">
          <button
            type="button"
            id="cancelResetBtn"
            class="px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold text-gray-700 hover:bg-gray-100 transition-colors"
          >
            Cancelar
          </button>
          <button
            type="button"
            id="confirmResetBtn"
            class="px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold text-white bg-amber-600 hover:bg-amber-700 transition-colors shadow-xs"
          >
            Sí, restaurar todo
          </button>
        </div>
      </div>
    </div>

    <!-- Toast Notification Container -->
    <div id="toast" class="fixed bottom-6 right-6 z-50 flex items-center gap-3 px-5 py-3 rounded-2xl bg-gray-900 text-white text-xs sm:text-sm shadow-xl border border-gray-800 transition-all duration-300 translate-y-20 opacity-0 pointer-events-none">
      <span id="toastIcon" class="w-2 h-2 rounded-full bg-emerald-400"></span>
      <span id="toastMsg">Cambios guardados con éxito</span>
    </div>

    <!-- Client-Side CMS JavaScript Engine -->
    <script is:inline>
      // 1. Initial State parsing
      const initialConfig = JSON.parse(document.getElementById('config-data').textContent);
      let state = JSON.parse(JSON.stringify(initialConfig));
      let isDirty = false;

      // 2. DOM Elements
      const statusBadge = document.getElementById('statusBadge');
      const statusDot = document.getElementById('statusDot');
      const statusText = document.getElementById('statusText');
      const saveAllBtn = document.getElementById('saveAllBtn');
      const saveSpinner = document.getElementById('saveSpinner');
      const saveText = document.getElementById('saveText');
      const toast = document.getElementById('toast');
      const toastMsg = document.getElementById('toastMsg');
      const toastIcon = document.getElementById('toastIcon');

      function showToast(message, isError = false) {
        toastMsg.textContent = message;
        toastIcon.className = isError ? 'w-2 h-2 rounded-full bg-rose-500' : 'w-2 h-2 rounded-full bg-emerald-400';
        toast.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
        setTimeout(() => {
          toast.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
        }, 3500);
      }

      function setDirty(dirty = true) {
        isDirty = dirty;
        if (dirty) {
          statusBadge.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-amber-50 text-amber-800 border border-amber-300 transition-all animate-pulse';
          statusDot.className = 'w-2 h-2 rounded-full bg-amber-500';
          statusText.textContent = 'Cambios sin guardar';
        } else {
          statusBadge.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-200 transition-all';
          statusDot.className = 'w-2 h-2 rounded-full bg-emerald-500';
          statusText.textContent = 'Todos los cambios guardados';
        }
      }

      // 3. Tab Switching
      const tabs = document.querySelectorAll('.nav-tab');
      const tabPanes = document.querySelectorAll('.tab-pane');

      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          const target = tab.getAttribute('data-tab');
          tabs.forEach(t => {
            t.classList.remove('active', 'bg-teal-50', 'text-teal-800');
            t.classList.add('text-gray-600');
            const icon = t.querySelector('svg');
            if (icon) {
              icon.classList.remove('text-teal-600');
              icon.classList.add('text-gray-400');
            }
          });

          tab.classList.add('active', 'bg-teal-50', 'text-teal-800');
          tab.classList.remove('text-gray-600');
          const activeIcon = tab.querySelector('svg');
          if (activeIcon) {
            activeIcon.classList.remove('text-gray-400');
            activeIcon.classList.add('text-teal-600');
          }

          tabPanes.forEach(pane => {
            if (pane.id === target) {
              pane.classList.remove('hidden');
            } else {
              pane.classList.add('hidden');
            }
          });
        });
      });

      // 4. Fill Static Inputs
      function populateStaticInputs() {
        // Banner
        const bannerActive = document.getElementById('banner_active');
        if (bannerActive) bannerActive.checked = !!state.banner?.active;
        const bannerLabel = document.getElementById('bannerActiveLabel');
        if (bannerLabel) bannerLabel.textContent = state.banner?.active ? 'Activo' : 'Desactivado';
        document.getElementById('banner_message').value = state.banner?.message || '';
        document.getElementById('banner_linkText').value = state.banner?.linkText || '';
        document.getElementById('banner_linkUrl').value = state.banner?.linkUrl || '';

        // Hero
        document.getElementById('hero_title').value = state.hero?.title || '';
        document.getElementById('hero_titleHighlight').value = state.hero?.titleHighlight || '';
        document.getElementById('hero_subtitle').value = state.hero?.subtitle || '';
        document.getElementById('hero_badge').value = state.hero?.badge || '';
        document.getElementById('hero_registryNotice').value = state.hero?.registryNotice || '';
        document.getElementById('hero_ctaText').value = state.hero?.ctaText || '';
        document.getElementById('hero_ctaLink').value = state.hero?.ctaLink || '';
        document.getElementById('hero_phoneText').value = state.hero?.phoneText || '';

        // About / Luisa
        document.getElementById('about_luisaName').value = state.about?.luisaName || '';
        document.getElementById('about_luisaRole').value = state.about?.luisaRole || '';
        document.getElementById('about_luisaRegNotice').value = state.about?.luisaRegNotice || '';
        document.getElementById('about_luisaBio1').value = state.about?.luisaBio1 || '';
        document.getElementById('about_luisaBio2').value = state.about?.luisaBio2 || '';
        document.getElementById('about_quienesSomosTitle').value = state.about?.quienesSomosTitle || '';
        document.getElementById('about_quienesSomosText').value = state.about?.quienesSomosText || '';
        document.getElementById('about_formacionTitle').value = state.about?.formacionTitle || '';
        document.getElementById('about_formacionText').value = state.about?.formacionText || '';
        document.getElementById('about_supervisionTitle').value = state.about?.supervisionTitle || '';
        document.getElementById('about_supervisionText').value = state.about?.supervisionText || '';

        // Tarifas Headers
        document.getElementById('tarifas_badge').value = state.tarifas?.badge || '';
        document.getElementById('tarifas_title').value = state.tarifas?.title || '';
        document.getElementById('tarifas_titleHighlight').value = state.tarifas?.titleHighlight || '';
        document.getElementById('tarifas_durationNotice').value = state.tarifas?.durationNotice || '';
        document.getElementById('tarifas_subtitle').value = state.tarifas?.subtitle || '';

        // Citas & Contacto
        document.getElementById('cita_bookingStepsDesc').value = state.citaYContacto?.bookingStepsDescription || '';
        document.getElementById('cita_questionnaireTitle').value = state.citaYContacto?.questionnaireTitle || '';
        document.getElementById('cita_questionnaireUrl').value = state.citaYContacto?.questionnaireUrl || '';
        document.getElementById('cita_questionnaireQuote').value = state.citaYContacto?.questionnaireQuote || '';
        document.getElementById('cita_availabilityTitle').value = state.citaYContacto?.availabilityTitle || '';
        document.getElementById('cita_availabilityNotice').value = state.citaYContacto?.availabilityNotice || '';
        document.getElementById('cita_phoneFormatted').value = state.citaYContacto?.phoneFormatted || '';
        document.getElementById('cita_whatsapp').value = state.citaYContacto?.whatsapp || '';
        document.getElementById('cita_whatsappMessage').value = state.citaYContacto?.whatsappMessage || '';
        document.getElementById('cita_email').value = state.citaYContacto?.email || '';
        document.getElementById('cita_address').value = state.citaYContacto?.address || '';
        document.getElementById('cita_schedule').value = state.citaYContacto?.schedule || '';
        document.getElementById('cita_mapsUrl').value = state.citaYContacto?.mapsUrl || '';
        document.getElementById('cita_cancellationPolicy').value = state.citaYContacto?.cancellationPolicy || '';
        document.getElementById('cita_fachadaTitle').value = state.citaYContacto?.fachadaTitle || '';
        document.getElementById('cita_fachadaText').value = state.citaYContacto?.fachadaText || '';

        // SEO
        document.getElementById('seo_metaTitle').value = state.seo?.metaTitle || '';
        document.getElementById('seo_metaDescription').value = state.seo?.metaDescription || '';

        // Images
        const imgHero = document.getElementById('img_hero');
        imgHero.value = state.images?.hero || '';
        document.getElementById('preview_img_hero').src = imgHero.value;

        const imgLuisa = document.getElementById('img_luisaProfile');
        imgLuisa.value = state.images?.luisaProfile || '';
        document.getElementById('preview_img_luisaProfile').src = imgLuisa.value;

        const imgBanner = document.getElementById('img_banner');
        imgBanner.value = state.images?.banner || '';
        document.getElementById('preview_img_banner').src = imgBanner.value;

        const imgBanner2 = document.getElementById('img_banner2');
        imgBanner2.value = state.images?.banner2 || '';
        document.getElementById('preview_img_banner2').src = imgBanner2.value;

        const imgFachada = document.getElementById('img_fachada');
        imgFachada.value = state.images?.fachada || '';
        document.getElementById('preview_img_fachada').src = imgFachada.value;

        const imgLogo = document.getElementById('img_logo');
        imgLogo.value = state.images?.logo || '';
        document.getElementById('preview_img_logo').src = imgLogo.value;
      }

      // Listen for static input changes
      document.body.addEventListener('input', (e) => {
        if (e.target.matches('input, textarea, select')) {
          setDirty(true);
        }
      });

      const bannerToggle = document.getElementById('banner_active');
      if (bannerToggle) {
        bannerToggle.addEventListener('change', () => {
          const label = document.getElementById('bannerActiveLabel');
          if (label) label.textContent = bannerToggle.checked ? 'Activo' : 'Desactivado';
          setDirty(true);
        });
      }

      // Handle image url text changes to update preview
      ['hero', 'luisaProfile', 'banner', 'banner2', 'fachada', 'logo'].forEach(k => {
        const inp = document.getElementById(`img_${k}`);
        const prev = document.getElementById(`preview_img_${k}`);
        if (inp && prev) {
          inp.addEventListener('input', () => {
            prev.src = inp.value;
          });
        }
      });

      // 5. Render Dynamic Lists (Team, Servicios, Tarifas)
      
      // === TEAM ===
      function renderTeamList() {
        const container = document.getElementById('teamListContainer');
        if (!container) return;
        container.innerHTML = '';

        if (!state.team || state.team.length === 0) {
          container.innerHTML = '<p class="text-xs text-gray-400 py-4 text-center">No hay profesionales registrados en el equipo.</p>';
          return;
        }

        state.team.forEach((m, idx) => {
          const card = document.createElement('div');
          card.className = 'p-5 rounded-2xl bg-gray-50 border border-gray-200/80 space-y-4 hover:border-teal-200 transition-colors';
          card.innerHTML = `
            <div class="flex items-center justify-between border-b border-gray-200/60 pb-3">
              <div class="flex items-center gap-2">
                <span class="w-6 h-6 rounded-full bg-teal-100 text-teal-800 text-xs font-bold flex items-center justify-center">
                  ${idx + 1}
                </span>
                <span class="text-xs font-semibold text-gray-800">${m.name || 'Nueva profesional'}</span>
              </div>
              <div class="flex items-center gap-1.5">
                <button type="button" class="team-up p-1 rounded-lg hover:bg-gray-200 text-gray-500 hover:text-gray-800 disabled:opacity-30" title="Subir" ${idx === 0 ? 'disabled' : ''}>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/></svg>
                </button>
                <button type="button" class="team-down p-1 rounded-lg hover:bg-gray-200 text-gray-500 hover:text-gray-800 disabled:opacity-30" title="Bajar" ${idx === state.team.length - 1 ? 'disabled' : ''}>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                </button>
                <button type="button" class="team-del p-1 rounded-lg hover:bg-red-50 text-gray-400 hover:text-red-600 transition-colors" title="Eliminar profesional">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                </button>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-[11px] font-semibold text-gray-600 mb-1">Nombre completo</label>
                <input type="text" class="team-name w-full px-3 py-1.5 rounded-xl bg-white border border-gray-200 text-xs sm:text-sm text-gray-800" value="${m.name || ''}" />
              </div>
              <div>
                <label class="block text-[11px] font-semibold text-gray-600 mb-1">Cargo y Colegiación</label>
                <input type="text" class="team-role w-full px-3 py-1.5 rounded-xl bg-white border border-gray-200 text-xs sm:text-sm text-gray-800" value="${m.role || ''}" />
              </div>
            </div>

            <div>
              <label class="block text-[11px] font-semibold text-gray-600 mb-1">Biografía</label>
              <textarea rows="3" class="team-bio w-full px-3 py-1.5 rounded-xl bg-white border border-gray-200 text-xs text-gray-800 leading-relaxed">${m.bio || ''}</textarea>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-[11px] font-semibold text-gray-600 mb-1">Especialidades (separadas por comas)</label>
                <input type="text" class="team-tags w-full px-3 py-1.5 rounded-xl bg-white border border-gray-200 text-xs text-gray-800" value="${(m.tags || []).join(', ')}" />
              </div>
              <div>
                <label class="block text-[11px] font-semibold text-gray-600 mb-1">Foto (R2 o URL)</label>
                <div class="flex items-center gap-2">
                  <input type="text" class="team-photo w-full px-3 py-1.5 rounded-xl bg-white border border-gray-200 text-xs text-gray-800" value="${m.photoUrl || ''}" />
                  <label class="shrink-0 px-2.5 py-1.5 rounded-xl bg-white hover:bg-teal-50 text-teal-700 border border-teal-200 text-xs font-semibold cursor-pointer">
                    <span>Subir</span>
                    <input type="file" accept="image/webp,image/jpeg,image/png" class="sr-only team-file" />
                  </label>
                </div>
              </div>
            </div>
          `;

          // Event bindings
          const nameInput = card.querySelector('.team-name');
          nameInput.addEventListener('input', (e) => { m.name = e.target.value; setDirty(true); });

          const roleInput = card.querySelector('.team-role');
          roleInput.addEventListener('input', (e) => { m.role = e.target.value; setDirty(true); });

          const bioInput = card.querySelector('.team-bio');
          bioInput.addEventListener('input', (e) => { m.bio = e.target.value; setDirty(true); });

          const tagsInput = card.querySelector('.team-tags');
          tagsInput.addEventListener('input', (e) => {
            m.tags = e.target.value.split(',').map(s => s.trim()).filter(Boolean);
            setDirty(true);
          });

          const photoInput = card.querySelector('.team-photo');
          photoInput.addEventListener('input', (e) => { m.photoUrl = e.target.value; setDirty(true); });

          const fileInput = card.querySelector('.team-file');
          fileInput.addEventListener('change', async () => {
            const file = fileInput.files?.[0];
            if (!file) return;
            const url = await uploadImage(file);
            if (url) {
              m.photoUrl = url;
              photoInput.value = url;
              setDirty(true);
            }
          });

          card.querySelector('.team-up').addEventListener('click', () => {
            if (idx > 0) {
              const temp = state.team[idx];
              state.team[idx] = state.team[idx - 1];
              state.team[idx - 1] = temp;
              renderTeamList();
              setDirty(true);
            }
          });

          card.querySelector('.team-down').addEventListener('click', () => {
            if (idx < state.team.length - 1) {
              const temp = state.team[idx];
              state.team[idx] = state.team[idx + 1];
              state.team[idx + 1] = temp;
              renderTeamList();
              setDirty(true);
            }
          });

          card.querySelector('.team-del').addEventListener('click', () => {
            if (confirm(`¿Eliminar a ${m.name || 'esta persona'} del equipo?`)) {
              state.team.splice(idx, 1);
              renderTeamList();
              setDirty(true);
            }
          });

          container.appendChild(card);
        });
      }

      const addTeamBtn = document.getElementById('addTeamBtn');
      if (addTeamBtn) {
        addTeamBtn.addEventListener('click', () => {
          if (!state.team) state.team = [];
          state.team.push({
            id: 'team-' + Date.now(),
            name: '',
            role: 'Psicóloga Sanitaria',
            bio: '',
            photoUrl: '/assets/media/alba.jpeg',
            tags: ['Atención Clínica'],
            citaLink: '#contacto'
          });
          renderTeamList();
          setDirty(true);
        });
      }

      // === SERVICIOS ===
      function renderServiciosList() {
        const container = document.getElementById('serviciosListContainer');
        if (!container) return;
        container.innerHTML = '';

        if (!state.servicios || state.servicios.length === 0) {
          container.innerHTML = '<p class="text-xs text-gray-400 py-4 text-center">No hay servicios registrados.</p>';
