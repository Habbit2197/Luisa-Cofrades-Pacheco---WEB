      }

      const addTarifaBtn = document.getElementById('addTarifaBtn');
      if (addTarifaBtn) {
        addTarifaBtn.addEventListener('click', () => {
          if (!state.tarifas) state.tarifas = { badge: '', title: '', titleHighlight: '', durationNotice: '', subtitle: '', items: [] };
          if (!state.tarifas.items) state.tarifas.items = [];
          state.tarifas.items.push({
            id: 'tarifa-' + Date.now(),
            name: '',
            price: '80 €',
            duration: '50 minutos',
            tag: 'Individual',
            modality: 'Presencial u Online',
            description: '',
            highlight: false
          });
          renderTarifasList();
          setDirty(true);
        });
      }

      // 6. Image Upload Handler
      async function uploadImage(file) {
        const formData = new FormData();
        formData.append('file', file);
        showToast('Subiendo imagen a Cloudflare R2...');

        try {
          const res = await fetch('/api/admin/upload', {
            method: 'POST',
            body: formData
          });
          const data = await res.json();
          if (!res.ok || !data.success) {
            throw new Error(data.error || 'Fallo en la subida');
          }
          showToast('Imagen subida correctamente');
          return data.url;
        } catch (err) {
          showToast('Error al subir: ' + (err.message || 'Error de red'), true);
          return null;
        }
      }

      document.querySelectorAll('.image-uploader').forEach(input => {
        input.addEventListener('change', async () => {
          const file = input.files?.[0];
          if (!file) return;
          const targetId = input.getAttribute('data-target');
          const previewId = input.getAttribute('data-preview');
          const url = await uploadImage(file);
          if (url) {
            const targetEl = document.getElementById(targetId);
            const prevEl = document.getElementById(previewId);
            if (targetEl) targetEl.value = url;
            if (prevEl) prevEl.src = url;
            setDirty(true);
          }
        });
      });

      // 7. Collect and Save State
      function collectFormState() {
        const next = JSON.parse(JSON.stringify(state));

        // Banner
        next.banner = next.banner || {};
        next.banner.active = document.getElementById('banner_active').checked;
        next.banner.message = document.getElementById('banner_message').value;
        next.banner.linkText = document.getElementById('banner_linkText').value;
        next.banner.linkUrl = document.getElementById('banner_linkUrl').value;

        // Hero
        next.hero = next.hero || {};
        next.hero.title = document.getElementById('hero_title').value;
        next.hero.titleHighlight = document.getElementById('hero_titleHighlight').value;
        next.hero.subtitle = document.getElementById('hero_subtitle').value;
        next.hero.badge = document.getElementById('hero_badge').value;
        next.hero.registryNotice = document.getElementById('hero_registryNotice').value;
        next.hero.ctaText = document.getElementById('hero_ctaText').value;
        next.hero.ctaLink = document.getElementById('hero_ctaLink').value;
        next.hero.phoneText = document.getElementById('hero_phoneText').value;

        // About / Luisa
        next.about = next.about || {};
