      }

      async function saveChanges() {
        const payload = collectFormState();
        saveSpinner.classList.remove('hidden');
        saveText.textContent = 'Guardando...';
        saveAllBtn.disabled = true;

        try {
          const res = await fetch('/api/admin/config', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
          });
          const data = await res.json();
          if (!res.ok || !data.success) {
            throw new Error(data.error || 'Error al guardar');
          }
          state = data.config;
          setDirty(false);
          showToast('Configuración guardada correctamente');
        } catch (err) {
          showToast('Error al guardar: ' + (err.message || 'Error de red'), true);
        } finally {
          saveSpinner.classList.add('hidden');
          saveText.textContent = 'Guardar cambios';
          saveAllBtn.disabled = false;
        }
      }

      saveAllBtn.addEventListener('click', saveChanges);

      // Keyboard Shortcut: Cmd+S / Ctrl+S
      window.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key === 's') {
          e.preventDefault();
          saveChanges();
        }
      });

      // 8. Reset Modal
      const resetModal = document.getElementById('resetModal');
      const openResetModalBtn = document.getElementById('openResetModalBtn');
      const cancelResetBtn = document.getElementById('cancelResetBtn');
      const confirmResetBtn = document.getElementById('confirmResetBtn');

      openResetModalBtn.addEventListener('click', () => {
        resetModal.classList.remove('hidden');
      });

      cancelResetBtn.addEventListener('click', () => {
        resetModal.classList.add('hidden');
      });

      confirmResetBtn.addEventListener('click', async () => {
        confirmResetBtn.disabled = true;
        confirmResetBtn.textContent = 'Restaurando...';
        try {
          const res = await fetch('/api/admin/config', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: 'reset' })
          });
          const data = await res.json();
          if (!res.ok || !data.success) {
            throw new Error(data.error || 'Error al restaurar');
          }
          state = data.config;
          populateStaticInputs();
          renderTeamList();
          renderServiciosList();
          renderTarifasList();
          setDirty(false);
          resetModal.classList.add('hidden');
          showToast('Valores por defecto restaurados con éxito');
        } catch (err) {
          showToast('Error: ' + (err.message || 'Error de red'), true);
        } finally {
          confirmResetBtn.disabled = false;
          confirmResetBtn.textContent = 'Sí, restaurar todo';
        }
      });

      // 9. Initial Load
      populateStaticInputs();
      renderTeamList();
      renderServiciosList();
      renderTarifasList();
      setDirty(false);
    </script>
  </body>
</html>
