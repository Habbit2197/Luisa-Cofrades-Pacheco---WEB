            </div>
          `;

          // Event bindings
          card.querySelector('.tar-name').addEventListener('input', (e) => { t.name = e.target.value; setDirty(true); });
          card.querySelector('.tar-price').addEventListener('input', (e) => { t.price = e.target.value; setDirty(true); });
          card.querySelector('.tar-dur').addEventListener('input', (e) => { t.duration = e.target.value; setDirty(true); });
          card.querySelector('.tar-tag').addEventListener('input', (e) => { t.tag = e.target.value; setDirty(true); });
          card.querySelector('.tar-mod').addEventListener('input', (e) => { t.modality = e.target.value; setDirty(true); });
          card.querySelector('.tar-desc').addEventListener('input', (e) => { t.description = e.target.value; setDirty(true); });
          card.querySelector('.tar-hl').addEventListener('change', (e) => {
