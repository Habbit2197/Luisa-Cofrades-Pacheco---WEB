        next.about.luisaRole = document.getElementById('about_luisaRole').value;
        next.about.luisaRegNotice = document.getElementById('about_luisaRegNotice').value;
        next.about.luisaBio1 = document.getElementById('about_luisaBio1').value;
        next.about.luisaBio2 = document.getElementById('about_luisaBio2').value;
        next.about.quienesSomosTitle = document.getElementById('about_quienesSomosTitle').value;
        next.about.quienesSomosText = document.getElementById('about_quienesSomosText').value;
        next.about.formacionTitle = document.getElementById('about_formacionTitle').value;
        next.about.formacionText = document.getElementById('about_formacionText').value;
        next.about.supervisionTitle = document.getElementById('about_supervisionTitle').value;
        next.about.supervisionText = document.getElementById('about_supervisionText').value;

        // Tarifas
        next.tarifas = next.tarifas || {};
        next.tarifas.badge = document.getElementById('tarifas_badge').value;
        next.tarifas.title = document.getElementById('tarifas_title').value;
        next.tarifas.titleHighlight = document.getElementById('tarifas_titleHighlight').value;
        next.tarifas.durationNotice = document.getElementById('tarifas_durationNotice').value;
        next.tarifas.subtitle = document.getElementById('tarifas_subtitle').value;

        // Cita y Contacto
        next.citaYContacto = next.citaYContacto || {};
        next.citaYContacto.bookingStepsDescription = document.getElementById('cita_bookingStepsDesc').value;
        next.citaYContacto.questionnaireTitle = document.getElementById('cita_questionnaireTitle').value;
        next.citaYContacto.questionnaireUrl = document.getElementById('cita_questionnaireUrl').value;
        next.citaYContacto.questionnaireQuote = document.getElementById('cita_questionnaireQuote').value;
        next.citaYContacto.availabilityTitle = document.getElementById('cita_availabilityTitle').value;
        next.citaYContacto.availabilityNotice = document.getElementById('cita_availabilityNotice').value;
        next.citaYContacto.phoneFormatted = document.getElementById('cita_phoneFormatted').value;
        next.citaYContacto.whatsapp = document.getElementById('cita_whatsapp').value;
        next.citaYContacto.whatsappMessage = document.getElementById('cita_whatsappMessage').value;
        next.citaYContacto.email = document.getElementById('cita_email').value;
        next.citaYContacto.address = document.getElementById('cita_address').value;
        next.citaYContacto.schedule = document.getElementById('cita_schedule').value;
        next.citaYContacto.mapsUrl = document.getElementById('cita_mapsUrl').value;
        next.citaYContacto.cancellationPolicy = document.getElementById('cita_cancellationPolicy').value;
        next.citaYContacto.fachadaTitle = document.getElementById('cita_fachadaTitle').value;
        next.citaYContacto.fachadaText = document.getElementById('cita_fachadaText').value;

        // SEO
        next.seo = next.seo || {};
        next.seo.metaTitle = document.getElementById('seo_metaTitle').value;
        next.seo.metaDescription = document.getElementById('seo_metaDescription').value;

        // Images
        next.images = next.images || {};
        next.images.hero = document.getElementById('img_hero').value;
