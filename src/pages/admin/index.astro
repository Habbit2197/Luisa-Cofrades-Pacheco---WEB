            </div>
          `;

          // Event bindings
          card.querySelector('.serv-title').addEventListener('input', (e) => { s.title = e.target.value; setDirty(true); });
          card.querySelector('.serv-tagline').addEventListener('input', (e) => { s.tagline = e.target.value; setDirty(true); });
          card.querySelector('.serv-badge').addEventListener('input', (e) => { s.badge = e.target.value; setDirty(true); });
          card.querySelector('.serv-desc').addEventListener('input', (e) => { s.desc = e.target.value; setDirty(true); });
          card.querySelector('.serv-icon').addEventListener('change', (e) => { s.icon = e.target.value; setDirty(true); });

          card.querySelector('.serv-up').addEventListener('click', () => {
