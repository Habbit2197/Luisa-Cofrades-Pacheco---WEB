          });

          card.querySelector('.tar-up').addEventListener('click', () => {
            if (idx > 0) {
              const temp = state.tarifas.items[idx];
              state.tarifas.items[idx] = state.tarifas.items[idx - 1];
              state.tarifas.items[idx - 1] = temp;
              renderTarifasList();
              setDirty(true);
            }
          });

          card.querySelector('.tar-down').addEventListener('click', () => {
            if (idx < state.tarifas.items.length - 1) {
              const temp = state.tarifas.items[idx];
              state.tarifas.items[idx] = state.tarifas.items[idx + 1];
              state.tarifas.items[idx + 1] = temp;
              renderTarifasList();
              setDirty(true);
            }
          });

          card.querySelector('.tar-del').addEventListener('click', () => {
