---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import { ArrowLeft, Calendar, User, HeartHandshake, Phone } from 'lucide-react';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
  const dataPath = path.resolve('data.json');
  const siteData = JSON.parse(fs.readFileSync(dataPath, 'utf8'));

  return (siteData.posts || []).map((post: any) => ({
    params: { slug: post.slug },
    props: { post }
  }));
}

const { post } = Astro.props;

// Separar contenido en párrafos limpios
const parrafos = post.contenidoCompleto
  ? post.contenidoCompleto.split(/(?<=\.)\s+(?=[A-Z¿¡])/)
  : [post.resumen];
---

<Layout 
  title={`${post.titulo} | Luisa Cofrades Pacheco`}
  description={post.resumen}
>
  <header class="bg-gradient-to-b from-brand-100/60 via-sand-50/80 to-sand-50 border-b border-sand-200/80 pt-20 pb-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <a 
        href="/blog" 
        class="inline-flex items-center gap-2 text-xs sm:text-sm font-medium text-brand-700 hover:text-brand-900 mb-6 transition-colors group"
      >
        <ArrowLeft class="w-4 h-4 group-hover:-translate-x-1 transition-transform" />
        <span>Volver a todos los artículos</span>
      </a>

      <div class="flex items-center gap-4 text-xs sm:text-sm text-brand-800 font-medium mb-4">
        <span class="inline-flex items-center gap-1.5">
          <Calendar class="w-4 h-4 text-brand-600" />
          <span>{post.fecha ? new Date(post.fecha).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' }) : 'Psicología'}</span>
        </span>
        <span>·</span>
        <span class="inline-flex items-center gap-1.5">
          <User class="w-4 h-4 text-brand-600" />
          <span>Luisa Cofrades Pacheco</span>
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-light text-slateText-dark tracking-tight leading-tight">
        {post.titulo}
      </h1>
    </div>
  </header>

  <article class="py-16 bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="space-y-6 text-slateText-base leading-relaxed text-base sm:text-lg">
        {parrafos.map((p: string) => (
          <p class="leading-relaxed text-slateText-base/90">
            {p}
          </p>
        ))}
      </div>

      <!-- Bloque de Autor y Contacto -->
      <div class="mt-16 p-8 rounded-3xl bg-sand-50 border border-sand-200 space-y-4">
        <div class="flex items-center gap-4">
          <img 
            src="/assets/branding/cropped-logo-simbolo404x.png" 
            alt="Luisa Cofrades" 
            class="w-14 h-14 object-contain rounded-full bg-white p-1 border border-sand-200"
          />
          <div>
            <h3 class="text-base font-semibold text-slateText-dark">Luisa Cofrades Pacheco</h3>
            <p class="text-xs text-brand-700 font-medium">Psicóloga Sanitaria · Colegiada BI05747</p>
          </div>
        </div>

        <p class="text-xs sm:text-sm text-slateText-muted leading-relaxed">
          Especialista en EMDR, trauma y psicoterapia integrativa. Atiende consultas presenciales en <strong>Salamanca</strong> y <strong>Zamora</strong>, y sesiones en formato online.
        </p>

        <div class="pt-2 flex flex-col sm:flex-row gap-3">
          <a 
            href="/#contacto" 
            class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-xs sm:text-sm font-medium transition-colors"
          >
            <HeartHandshake class="w-4 h-4" />
            <span>Consultar sobre este tema</span>
          </a>

          <a 
            href="tel:+34675809974" 
            class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-white hover:bg-sand-100 text-slateText-dark border border-sand-200 text-xs sm:text-sm font-medium transition-colors"
          >
            <Phone class="w-4 h-4 text-brand-600" />
            <span>Llamar al 675 80 99 74</span>
          </a>
        </div>
      </div>

    </div>
  </article>

  <Footer />
</Layout>

