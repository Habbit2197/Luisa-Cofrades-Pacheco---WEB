---
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';
import { BookOpen, Calendar, ArrowRight, User, Sparkles } from 'lucide-react';
import fs from 'node:fs';
import path from 'node:path';

const dataPath = path.resolve('data.json');
const siteData = JSON.parse(fs.readFileSync(dataPath, 'utf8'));
const posts = siteData.posts || [];
---

<Layout 
  title="Artículos y Reflexiones de Psicología | Luisa Cofrades"
  description="Artículos sobre ansiedad, trauma, relaciones, duelo y crecimiento personal escritos por Luisa Cofrades Pacheco, Psicóloga Sanitaria."
>
  <header class="bg-gradient-to-b from-brand-100/60 via-sand-50/80 to-sand-50 border-b border-sand-200/80 pt-24 pb-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-brand-200/60 text-brand-900 text-xs font-semibold uppercase tracking-wider mb-4 border border-brand-300/60">
        <Sparkles class="w-3.5 h-3.5 text-brand-700" />
        <span>Rincón de Divulgación y Salud Mental</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-light text-slateText-dark tracking-tight">
        Artículos, vivencias y <span class="font-semibold text-brand-700">reflexiones clínicas</span>
      </h1>
      <p class="mt-4 text-lg text-slateText-muted leading-relaxed max-w-2xl mx-auto">
        Textos y guías para comprender cómo funciona nuestra mente, nuestras emociones y los vínculos afectivos.
      </p>
    </div>
  </header>

  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post: any) => (
          <article class="bg-white rounded-3xl p-8 border border-sand-200 shadow-soft-elevation hover:shadow-card-hover hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-2 text-xs text-brand-700 font-medium mb-3">
                <Calendar class="w-3.5 h-3.5 text-brand-600" />
                <span>{post.fecha ? new Date(post.fecha).toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' }) : 'Psicología'}</span>
              </div>

              <h2 class="text-xl font-semibold text-slateText-dark hover:text-brand-700 transition-colors leading-snug">
                <a href={`/blog/${post.slug}`}>
                  {post.titulo}
                </a>
              </h2>

              <p class="mt-3.5 text-slateText-muted text-sm leading-relaxed">
                {post.resumen}
              </p>
            </div>

            <div class="mt-6 pt-4 border-t border-sand-100 flex items-center justify-between">
              <span class="text-xs text-slateText-muted flex items-center gap-1.5">
                <User class="w-3.5 h-3.5 text-brand-600" />
                <span>Luisa Cofrades</span>
              </span>

              <a 
                href={`/blog/${post.slug}`} 
                class="inline-flex items-center gap-1 text-xs font-semibold text-brand-600 hover:text-brand-800 transition-colors"
              >
                <span>Leer artículo</span>
                <ArrowRight class="w-3.5 h-3.5" />
              </a>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <Footer />
</Layout>

