---
import { Brain, Heart, Sparkles, Activity, Users, Scale, Shield, RotateCw, FileText, ArrowRight, Box } from 'lucide-react';
import { DEFAULT_CONFIG, type ServiceItem } from '../lib/siteConfig';

interface Props {
  servicios?: ServiceItem[];
}

const { servicios: propServicios } = Astro.props;
const activeServicios = propServicios && propServicios.length > 0 ? propServicios : DEFAULT_CONFIG.servicios;

// Mapa dinámico de iconos
const iconMap: Record<string, any> = {
  brain: Brain,
  box: Box,
  activity: Activity,
  sparkles: Sparkles,
  users: Users,
  heart: Heart,
  scale: Scale,
  shield: Shield
};

// Paletas de color armónicas para cada posición
const colorPalettes = [
  { backBg: "bg-teal-50/90 border-teal-200/80", iconBg: "bg-teal-100/70 text-teal-700", accentColor: "text-teal-700" },
  { backBg: "bg-amber-50/90 border-amber-200/80", iconBg: "bg-amber-100/70 text-amber-700", accentColor: "text-amber-700" },
  { backBg: "bg-sky-50/90 border-sky-200/80", iconBg: "bg-sky-100/70 text-sky-700", accentColor: "text-sky-700" },
  { backBg: "bg-purple-50/90 border-purple-200/80", iconBg: "bg-purple-100/70 text-purple-700", accentColor: "text-purple-700" },
  { backBg: "bg-indigo-50/90 border-indigo-200/80", iconBg: "bg-indigo-100/70 text-indigo-700", accentColor: "text-indigo-700" },
  { backBg: "bg-rose-50/90 border-rose-200/80", iconBg: "bg-rose-100/70 text-rose-700", accentColor: "text-rose-700" },
  { backBg: "bg-emerald-50/90 border-emerald-200/80", iconBg: "bg-emerald-100/70 text-emerald-700", accentColor: "text-emerald-700" },
  { backBg: "bg-stone-50/90 border-stone-200/80", iconBg: "bg-stone-100/70 text-stone-700", accentColor: "text-stone-700" }
];
---

<section id="servicios" class="py-20 sm:py-24 lg:py-28 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 scroll-mt-20">
  <!-- Cabecera de la sección -->
  <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-brand-aqua/10 text-brand-aqua text-xs font-semibold uppercase tracking-wider mb-4 border border-brand-aqua/20">
      <Shield class="w-3.5 h-3.5 text-brand-aqua" />
      <span>Áreas de Intervención y Terapias</span>
    </div>
    <h2 class="text-3xl sm:text-4xl lg:text-5xl font-light text-brand-graphite tracking-tight leading-tight">
      Un enfoque integrador y científico, <br />
      <span class="font-semibold text-brand-aqua">centrado en tu historia única</span>
    </h2>
    <p class="mt-4 text-sm sm:text-base md:text-lg text-brand-graphite/70 leading-relaxed max-w-2xl mx-auto">
      Toca cualquier tarjeta para descubrir nuestro abordaje clínico para cada especialidad.
    </p>
  </div>

  <!-- Grid Interactivo de Flip Cards (2 columnas en móvil/tablet para experiencia compacta) -->
  <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3.5 sm:gap-6">
    {activeServicios.map((item, idx) => {
      const palette = colorPalettes[idx % colorPalettes.length];
      const iconKey = (item.icon || 'sparkles').toLowerCase();
      const Icon = iconMap[iconKey] || Sparkles;

      return (
        <div 
          id={item.id}
          class="flip-card-wrapper [perspective:1000px] min-h-[320px] w-full select-none cursor-pointer scroll-mt-24 sm:scroll-mt-28"
          role="button"
          tabindex="0"
          aria-label={`Tarjeta de servicio: ${item.title}. Haz clic para girar y leer descripción.`}
        >
          <div class="relative w-full h-full min-h-[320px] transition-transform duration-500 [transform-style:preserve-3d] flip-card-inner cursor-pointer">
            
            <!-- CARA FRONTAL (Front) -->
            <div class="flip-card-front absolute inset-0 w-full h-full [backface-visibility:hidden] flex flex-col items-center justify-center p-6 bg-gradient-to-br from-white to-gray-50 rounded-2xl border border-gray-100 shadow-sm text-center overflow-hidden">
              
              <!-- Badge superior -->
              <div class="w-full flex items-center justify-between text-[10px] sm:text-xs">
                {item.badge ? (
                  <span class="px-2 py-0.5 rounded-full bg-white/90 border border-gray-200/80 text-gray-600 font-medium tracking-tight shadow-2xs truncate max-w-[130px]">
                    {item.badge}
                  </span>
                ) : <span />}
                
                <span class="text-gray-400 hover:text-brand-aqua transition-colors flex items-center gap-1 font-medium" title="Girar">
                  <RotateCw class="w-3.5 h-3.5" />
                </span>
              </div>

              <!-- Contenido Central: Icono y Título -->
              <div class="flex flex-col items-center justify-center my-auto px-1">
                <div class={`w-12 h-12 sm:w-16 sm:h-16 rounded-2xl ${palette.iconBg} flex items-center justify-center shadow-xs mb-3 transition-transform duration-300`}>
                  <Icon class="w-6 h-6 sm:w-8 sm:h-8" />
                </div>
                
                <h3 class="text-xs sm:text-sm md:text-base font-semibold text-brand-graphite leading-snug tracking-tight">
                  {item.title}
                </h3>

                <p class="text-[10px] sm:text-xs text-brand-aqua font-medium mt-1 uppercase tracking-wider">
                  {item.tagline}
                </p>
              </div>

              <!-- Pie frontal con indicación de interacción -->
              <div class="w-full pt-2 border-t border-gray-200/60 flex items-center justify-center">
                <span class="inline-flex items-center gap-1 text-[11px] sm:text-xs font-semibold text-brand-aqua transition-colors">
                  <span>Tocar para ver</span>
                  <ArrowRight class="w-3 h-3" />
                </span>
              </div>

            </div>

            <!-- CARA TRASERA (Back) -->
            <div class={`flip-card-back absolute inset-0 w-full h-full [backface-visibility:hidden] [transform:rotateY(180deg)] flex flex-col items-center justify-center p-6 ${palette.backBg} rounded-2xl shadow-md border text-center overflow-y-auto`}>
              
              <!-- Título de cabecera trasera -->
              <div class="w-full flex items-center justify-between pb-1.5 border-b border-black/5">
                <span class={`text-[10px] sm:text-xs font-bold uppercase tracking-wider ${palette.accentColor} truncate pr-2`}>
                  {item.title}
                </span>
                <span class="text-gray-400 shrink-0" title="Volver al frente">
                  <RotateCw class="w-3.5 h-3.5" />
                </span>
              </div>

              <!-- Texto Descriptivo Centrado y Legible -->
              <div class="my-auto py-2 px-1">
                <p class="text-[11px] sm:text-xs md:text-[13px] text-brand-graphite leading-relaxed text-center font-normal">
                  {item.desc}
                </p>
              </div>

              <!-- Acciones al pie -->
              <div class="w-full pt-2 border-t border-black/5 flex flex-col gap-1 items-center justify-center">
                {item.pdfUrl && (
                  <a 
                    href={item.pdfUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1 text-[11px] font-semibold text-brand-aqua hover:underline"
                    onclick="event.stopPropagation();"
                  >
                    <FileText class="w-3 h-3" />
                    <span>Guía en PDF</span>
                  </a>
                )}

                <a 
                  href="#contacto"
                  class="inline-flex items-center gap-1 text-[11px] sm:text-xs font-semibold text-brand-aqua hover:text-brand-aqua-dark transition-colors"
                  onclick="event.stopPropagation();"
                >
                  <span>Concertar cita</span>
                  <ArrowRight class="w-3 h-3" />
                </a>
              </div>

            </div>

          </div>
        </div>
      );
    })}
  </div>
</section>

<style>
  /* Soporte de compatibilidad WebKit para animaciones 3D fluidas */
  .flip-card-inner {
    -webkit-transform-style: preserve-3d;
    transform-style: preserve-3d;
  }
  .flip-card-front,
  .flip-card-back {
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }
  .flip-card-inner.\[transform\:rotateY\(180deg\)\] {
    transform: rotateY(180deg) !important;
    -webkit-transform: rotateY(180deg) !important;
  }
</style>

<script>
  function initFlipCards() {
    const cards = document.querySelectorAll('.flip-card-inner');
    cards.forEach(card => {
      // Limpiar listeners previos para evitar duplicados
      const newCard = card.cloneNode(true);
      card.parentNode?.replaceChild(newCard, card);
      
      newCard.addEventListener('click', function(e) {
        // Evitar giro si se hace clic en un enlace interno (ej. botón de cita)
        const target = e.target as HTMLElement;
        if (target.closest('a') || target.closest('button')) return;
        newCard.classList.toggle('[transform:rotateY(180deg)]');
      });
    });
  }

  // Ejecutar al cargar la página y en cada transición de Astro
  document.addEventListener('DOMContentLoaded', initFlipCards);
  document.addEventListener('astro:page-load', initFlipCards);
</script>
