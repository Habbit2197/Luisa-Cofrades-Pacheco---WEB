---
import { Phone, MessageCircle, Calendar } from 'lucide-react';
---

<!-- Barra ergonómica flotante exclusiva para dispositivos móviles -->
<div class="fixed bottom-4 left-4 right-4 z-40 md:hidden pointer-events-none">
  <div class="max-w-md mx-auto bg-slateText-dark/95 backdrop-blur-md rounded-2xl p-2 shadow-card-hover border border-white/10 flex items-center justify-between gap-2 pointer-events-auto">
    
    <a 
      href="tel:+34675809974" 
      class="flex-1 inline-flex items-center justify-center gap-1.5 py-2.5 px-3 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-semibold transition-colors"
      aria-label="Llamar por teléfono"
    >
      <Phone class="w-3.5 h-3.5 text-brand-400" />
      <span>Llamar</span>
    </a>

    <a 
      href="https://wa.me/34675809974?text=Hola%20Luisa,%20me%20gustar%C3%ADa%20solicitar%20informaci%C3%B3n%20para%20una%20primera%20cita%20de%20psicolog%C3%ADa." 
      target="_blank" 
      rel="noopener noreferrer"
      class="flex-1 inline-flex items-center justify-center gap-1.5 py-2.5 px-3 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-semibold transition-colors shadow-sm"
      aria-label="Abrir WhatsApp"
    >
      <MessageCircle class="w-3.5 h-3.5" />
      <span>WhatsApp</span>
    </a>

    <a 
      href="#contacto" 
      class="flex-1 inline-flex items-center justify-center gap-1.5 py-2.5 px-3 rounded-xl bg-brand-600 hover:bg-brand-700 text-white text-xs font-semibold transition-colors shadow-sm"
    >
      <Calendar class="w-3.5 h-3.5" />
      <span>Pedir cita</span>
    </a>

  </div>
</div>
