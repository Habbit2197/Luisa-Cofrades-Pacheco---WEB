---
import { Phone, MapPin, Mail, Award, ArrowUp, ExternalLink, ShieldCheck } from 'lucide-react';
---

<footer class="bg-slateText-dark text-sand-100 border-t border-slateText-muted/20 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-12">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-12 pb-16 border-b border-white/10">
      
      <!-- Columna 1: Identidad y Misión (5 columnas) -->
      <div class="lg:col-span-5 space-y-5">
        <div class="flex items-center gap-3">
          <img 
            src="/assets/branding/cropped-logo-simbolo404x.png" 
            alt="Luisa Cofrades Pacheco" 
            class="w-12 h-12 object-contain rounded-full bg-white/10 p-1"
          />
          <div>
            <h3 class="text-xl font-semibold text-white tracking-tight">Luisa Cofrades Pacheco</h3>
            <p class="text-xs uppercase tracking-widest text-brand-300 font-medium">Psicología para vivir</p>
          </div>
        </div>

        <p class="text-sm text-sand-200/80 leading-relaxed max-w-md">
          Gabinete de Psicología General Sanitaria y Psicoterapia. Especialista acreditada en EMDR, trauma y terapia sensoriomotriz. Docente colaboradora en el Máster de la Universidad de Salamanca.
        </p>

        <!-- Acreditaciones -->
        <div class="flex flex-wrap gap-2 pt-2">
          <span class="inline-flex items-center gap-1.5 text-xs text-brand-200 bg-brand-900/60 px-3 py-1.5 rounded-lg border border-brand-700/60">
            <Award class="w-3.5 h-3.5 text-brand-400" />
            <span>Asociación EMDR España</span>
          </span>
          <span class="inline-flex items-center gap-1.5 text-xs text-brand-200 bg-brand-900/60 px-3 py-1.5 rounded-lg border border-brand-700/60">
            <ShieldCheck class="w-3.5 h-3.5 text-brand-400" />
            <span>Perito Oficial TSJ CyL</span>
          </span>
        </div>
      </div>

      <!-- Columna 2: Sedes y Ubicaciones (3 columnas) -->
      <div class="lg:col-span-3 space-y-4">
        <h4 class="text-xs font-semibold uppercase tracking-wider text-white/90">
          Consultas Presenciales
        </h4>
        <div class="space-y-4 text-sm text-sand-200/80">
          <div>
            <p class="font-medium text-white flex items-center gap-1.5">
              <MapPin class="w-4 h-4 text-brand-400 shrink-0" />
              <span>Salamanca</span>
            </p>
            <p class="text-xs text-sand-200/70 mt-1 pl-5">Calle del Prior 5-7, 1º B · 37002</p>
            <a 
              href="https://maps.app.goo.gl/StfS44aCLH8NWewG6" 
              target="_blank" 
              rel="noopener"
              class="text-xs text-brand-300 hover:text-white transition-colors pl-5 inline-flex items-center gap-1 mt-0.5"
            >
              <span>Ver en Google Maps</span>
              <ExternalLink class="w-3 h-3" />
            </a>
          </div>

          <div class="pt-2 border-t border-white/5">
            <p class="font-medium text-white flex items-center gap-1.5">
              <MapPin class="w-4 h-4 text-brand-400 shrink-0" />
              <span>Zamora</span>
            </p>
            <p class="text-xs text-sand-200/70 mt-1 pl-5">Roelos de Sayago (Provincia de Zamora)</p>
          </div>
        </div>
      </div>

      <!-- Columna 3: Contacto y Redes (4 columnas) -->
      <div class="lg:col-span-4 space-y-4">
        <h4 class="text-xs font-semibold uppercase tracking-wider text-white/90">
          Atención y Citas
        </h4>
        <div class="space-y-3 text-sm text-sand-200/80">
          <a 
            href="tel:+34675809974" 
            class="flex items-center gap-3 p-3 rounded-xl bg-white/5 hover:bg-white/10 text-white transition-colors border border-white/10"
          >
            <Phone class="w-5 h-5 text-brand-400" />
            <div>
              <p class="text-xs text-sand-200/60">Llamadas y WhatsApp</p>
              <p class="text-base font-semibold">+34 675 80 99 74</p>
            </div>
          </a>

          <a 
            href="mailto:contacto@luisacofrades.com" 
            class="flex items-center gap-2.5 text-xs sm:text-sm text-sand-200/80 hover:text-white transition-colors pt-1"
          >
            <Mail class="w-4 h-4 text-brand-400" />
            <span>contacto@luisacofrades.com</span>
          </a>

          <!-- Redes Sociales Oficiales extraídas -->
          <div class="pt-3">
            <p class="text-xs text-sand-200/60 mb-2">Canales de difusión:</p>
            <div class="flex items-center gap-2">
              <a 
                href="https://twitter.com/LCofrades" 
                target="_blank" 
                rel="noopener noreferrer"
                class="w-9 h-9 rounded-lg bg-white/5 hover:bg-brand-600 flex items-center justify-center text-sand-200 hover:text-white transition-colors"
                aria-label="Perfil de Twitter / X de Luisa Cofrades"
              >
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Barra inferior legal y copyright -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-sand-200/60">
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
        <span>© {new Date().getFullYear()} Luisa Cofrades Pacheco · Colegiada BI05747</span>
        <a href="/aviso-legal" class="hover:text-sand-100 transition-colors">Aviso Legal</a>
        <a href="/politica-de-privacidad" class="hover:text-sand-100 transition-colors">Protección de Datos</a>
        <a href="/politica-de-cookies" class="hover:text-sand-100 transition-colors">Cookies</a>
        <a href="/blog" class="hover:text-sand-100 transition-colors">Artículos</a>
      </div>

      <div class="flex items-center gap-4">
        <span>Arquitectura Jamstack sobre Cloudflare Edge</span>
        <a 
          href="#top" 
          class="w-8 h-8 rounded-full bg-white/10 hover:bg-brand-600 flex items-center justify-center text-white transition-colors"
          aria-label="Volver arriba"
        >
          <ArrowUp class="w-4 h-4" />
        </a>
      </div>
    </div>

  </div>
</footer>
