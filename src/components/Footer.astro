---
import { Phone, MapPin, Mail, Award, ArrowUp, ExternalLink, ShieldCheck, Globe } from 'lucide-react';
import { DEFAULT_CONFIG, type SiteConfig } from '../lib/siteConfig';

interface Props {
  config?: SiteConfig;
}

const { config = DEFAULT_CONFIG } = Astro.props;
const contact = config.citaYContacto || DEFAULT_CONFIG.citaYContacto;
const images = config.images || DEFAULT_CONFIG.images;
---

<footer class="bg-brand-graphite text-white border-t border-gray-700/50 relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-12">
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-12 pb-16 border-b border-white/10">
      
      <!-- Columna 1: Identidad y Misión (5 columnas) -->
      <div class="lg:col-span-5 space-y-5">
        <div class="flex items-center gap-3">
          <img 
            src={images.logo || "/assets/branding/cropped-logo-simbolo404x.png"} 
            alt="Luisa Cofrades Pacheco" 
            width="48"
            height="48"
            loading="lazy"
            decoding="async"
            class="w-12 h-12 object-contain rounded-full bg-white/10 p-1"
          />
          <div>
            <h3 class="text-xl font-semibold text-white tracking-tight">Luisa Cofrades Pacheco</h3>
            <p class="text-xs uppercase tracking-widest text-brand-aqua font-semibold">Psicología para vivir</p>
          </div>
        </div>

        <p class="text-sm text-gray-300 leading-relaxed max-w-md">
          Gabinete de Psicología General Sanitaria y Psicoterapia. Especialista acreditada en EMDR y trauma. Docente colaboradora en el Máster de la Universidad de Salamanca.
        </p>

        <!-- Acreditaciones -->
        <div class="flex flex-wrap gap-2 pt-2">
          <span class="inline-flex items-center gap-1.5 text-xs text-brand-aqua bg-white/10 px-3 py-1.5 rounded-lg border border-brand-aqua/30">
            <Award class="w-3.5 h-3.5 text-brand-aqua" />
            <span>Asociación EMDR España</span>
          </span>
          <span class="inline-flex items-center gap-1.5 text-xs text-brand-aqua bg-white/10 px-3 py-1.5 rounded-lg border border-brand-aqua/30">
            <ShieldCheck class="w-3.5 h-3.5 text-brand-aqua" />
            <span>Perito Oficial TSJ CyL</span>
          </span>
          <span class="inline-flex items-center gap-1.5 text-xs text-brand-aqua bg-white/10 px-3 py-1.5 rounded-lg border border-brand-aqua/30">
            <ShieldCheck class="w-3.5 h-3.5 text-brand-aqua" />
            <span>Reg. Sanitario CyL: 37-C22-0544</span>
          </span>
        </div>
      </div>

      <!-- Columna 2: Sedes y Ubicaciones (3 columnas) -->
      <div class="lg:col-span-3 space-y-4">
        <h4 class="text-xs font-semibold uppercase tracking-wider text-white/90">
          Consultas Presenciales
        </h4>
        <div class="space-y-4 text-sm text-gray-300">
          <div>
            <p class="font-medium text-white flex items-center gap-1.5">
              <MapPin class="w-4 h-4 text-brand-aqua shrink-0" />
              <span>Salamanca</span>
            </p>
            <p class="text-xs text-gray-400 mt-1 pl-5">{contact.address}</p>
            <p class="text-[11px] text-gray-400 pl-5">{contact.addressDetails}</p>
            <a 
              href={contact.mapsUrl} 
              target="_blank" 
              rel="noopener noreferrer"
              class="text-xs text-brand-aqua hover:text-white transition-colors pl-5 inline-flex items-center gap-1 mt-0.5"
            >
              <span>Ver en Google Maps</span>
              <ExternalLink class="w-3 h-3" />
            </a>
          </div>

          <div class="pt-2 border-t border-white/5">
            <p class="font-medium text-white flex items-center gap-1.5">
              <Globe class="w-4 h-4 text-brand-aqua shrink-0" />
              <span>Consulta Online</span>
            </p>
            <p class="text-xs text-gray-400 mt-1 pl-5">Videoconsulta segura desde cualquier lugar</p>
          </div>
        </div>
      </div>

      <!-- Columna 3: Contacto y Redes (4 columnas) -->
      <div class="lg:col-span-4 space-y-4">
        <h4 class="text-xs font-semibold uppercase tracking-wider text-white/90">
          Atención y Citas
        </h4>
        <div class="space-y-3 text-sm text-gray-300">
          <a 
            href={`tel:${contact.phone}`} 
            aria-label={`Llamar o contactar por WhatsApp al ${contact.phoneFormatted}`}
            class="flex items-center gap-3 p-3 rounded-xl bg-white/5 hover:bg-white/10 text-white transition-colors border border-white/10"
          >
            <Phone class="w-5 h-5 text-brand-aqua" />
            <div>
              <p class="text-xs text-gray-400">Llamadas y WhatsApp</p>
              <p class="text-base font-semibold">{contact.phoneFormatted}</p>
            </div>
          </a>

          <a 
            href={`mailto:${contact.email}`} 
            class="flex items-center gap-3 p-3 rounded-xl bg-white/5 hover:bg-white/10 text-white transition-colors border border-white/10"
          >
            <Mail class="w-5 h-5 text-brand-aqua" />
            <div>
              <p class="text-xs text-gray-400">Correo Electrónico</p>
              <p class="text-sm font-semibold">{contact.email}</p>
            </div>
          </a>

          <div class="p-3 rounded-xl bg-white/5 border border-white/10 text-xs text-gray-400">
            <span class="text-white font-medium block mb-0.5">Horario de consulta:</span>
            {contact.schedule}
          </div>
        </div>
      </div>

    </div>

    <!-- Fila Inferior: Copyright, Registro Sanitario y Enlaces Legales -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-gray-400">
      <div class="flex flex-col sm:flex-row items-center gap-2 sm:gap-3 text-center sm:text-left">
        <p>&copy; {new Date().getFullYear()} Luisa Cofrades Pacheco. Todos los derechos reservados.</p>
        <span class="hidden sm:inline text-gray-600">·</span>
        <p class="text-brand-aqua font-medium">Registro Sanitario Junta de CyL: 37-C22-0544</p>
      </div>
      <div class="flex items-center gap-6">
        <a href="/aviso-legal" class="hover:text-brand-aqua transition-colors">Aviso Legal</a>
        <a href="/politica-de-privacidad" class="hover:text-brand-aqua transition-colors">Privacidad</a>
        <a href="/politica-de-cookies" class="hover:text-brand-aqua transition-colors">Cookies</a>
      </div>
    </div>

  </div>
</footer>
