---
import HeroMotion from './HeroMotion';

interface Props {
  subtitle?: string;
  badge?: string;
  imageUrl?: string;
}

const { subtitle, badge, imageUrl } = Astro.props;
---

<section class="relative overflow-hidden bg-white border-b border-gray-100">
  <!-- Patrón de textura sutil de fondo en tonos aqua muy suaves -->
  <div class="absolute inset-0 bg-[radial-gradient(#ACE1DE_1px,transparent_1px)] [background-size:32px_32px] opacity-25 pointer-events-none"></div>
  
  <HeroMotion client:load subtitle={subtitle} badge={badge} imageUrl={imageUrl} />
</section>
