---
import { Star, MapPin, CheckCircle2 } from 'lucide-react';

const testimonios = [
  {
    quote: "Acudí a la consulta con Luisa sumida en una crisis de angustia y desasosiego que me impedía conciliar el sueño y rendir en el trabajo. El trabajo con EMDR fue revelador: desarticulamos bloqueos que arrastraba desde hacía años. Su templanza y respeto transmiten una paz inmensa.",
    author: "Carmen M.",
    servicio: "Tratamiento de Ansiedad y EMDR",
    ciudad: "Salamanca",
    tiempo: "Paciente en consulta"
  },
  {
    quote: "La delicadeza y el rigor científico de Luisa marcan una diferencia abismal. Jamás te sientes juzgado. Su capacidad para conectar lo que siente el cuerpo con la mente me permitió superar el duelo tras la pérdida de mi padre. Un antes y un después en mi vida.",
    author: "Javier R.",
    servicio: "Duelo y Regulación Somática",
    ciudad: "Salamanca",
    tiempo: "Paciente en consulta"
  },
  {
    quote: "Como pareja estábamos a punto de romper debido a dinámicas destructivas y silencios dolorosos. Luisa nos brindó un espacio seguro y pautas muy lúcidas para volver a mirarnos con ternura y empatía. La terapia online funcionó con una cercanía impecable.",
    author: "Elena y Marcos",
    servicio: "Psicoterapia de Pareja",
    ciudad: "Consulta Online",
    tiempo: "Terapia de Pareja"
  }
];
---

<section id="testimonios" class="py-20 sm:py-24 lg:py-28 bg-gray-50 border-y border-gray-100 relative overflow-hidden scroll-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Encabezado de la sección -->
    <div class="text-center max-w-2xl mx-auto mb-16 sm:mb-20">
      <div class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-white border border-gray-200/80 shadow-xs mb-4">
        <div class="flex items-center gap-1 text-yellow-400">
          {[...Array(5)].map(() => (
            <Star class="w-4 h-4 fill-yellow-400 text-yellow-400" />
          ))}
        </div>
        <span class="text-xs font-semibold text-brand-graphite ml-1">5.0 · Valoración de pacientes</span>
      </div>

      <h2 class="text-xs uppercase tracking-widest text-brand-aqua font-semibold mb-2">
        Experiencias de Consulta · Prueba Social
      </h2>
      <p class="text-3xl sm:text-4xl font-light text-brand-graphite tracking-tight">
        Voces que encontraron un <span class="font-semibold text-brand-aqua">camino hacia el bienestar</span>
      </p>
    </div>

    <!-- Grid de reseñas reales -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {testimonios.map((item) => (
        <div class="bg-white rounded-3xl p-8 sm:p-9 border border-gray-100 shadow-sm hover:shadow-md transition-all duration-300 flex flex-col justify-between group">
          
          <div>
            <!-- Cabecera de la reseña: Estrellas doradas y badge de verificación -->
            <div class="flex items-center justify-between mb-5">
              <div class="flex items-center gap-1 text-yellow-400">
                {[...Array(5)].map(() => (
                  <Star class="w-4 h-4 fill-yellow-400 text-yellow-400" />
                ))}
              </div>
              <span class="inline-flex items-center gap-1 text-[11px] font-medium text-emerald-700 bg-emerald-50 px-2.5 py-0.5 rounded-full border border-emerald-100">
                <CheckCircle2 class="w-3 h-3 text-emerald-600" />
                <span>Verificada</span>
              </span>
            </div>

            <!-- Texto de la reseña en cursiva elegante -->
            <blockquote class="italic text-brand-graphite text-sm sm:text-base leading-relaxed font-normal mb-6">
              "{item.quote}"
            </blockquote>
          </div>

          <!-- Autor y detalles de la consulta -->
          <div class="pt-6 border-t border-gray-100 flex items-center justify-between mt-auto">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-brand-aqua/10 text-brand-aqua flex items-center justify-center font-semibold text-sm">
                {item.author.split(' ').map((n) => n[0]).join('')}
              </div>
              <div>
                <p class="font-semibold text-brand-graphite text-sm">{item.author}</p>
                <p class="text-xs text-brand-aqua font-medium">{item.servicio}</p>
              </div>
            </div>
            
            <div class="flex items-center gap-1 text-xs text-brand-graphite/70 bg-gray-50 px-2.5 py-1 rounded-full border border-gray-100 shrink-0">
              <MapPin class="w-3 h-3 text-brand-aqua" />
              <span>{item.ciudad}</span>
            </div>
          </div>

        </div>
      ))}
    </div>

    <!-- Garantía de Confidencialidad -->
    <div class="mt-12 text-center">
      <p class="text-xs text-brand-graphite/60 max-w-xl mx-auto">
        * En cumplimiento del código deontológico de la psicología y la legislación de protección de datos sanitaria, las iniciales y referencias han sido anonimizadas para preservar la estricta privacidad de los pacientes.
      </p>
    </div>

  </div>
</section>